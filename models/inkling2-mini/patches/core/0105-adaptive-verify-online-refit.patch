+class OnlineStepCosts:
+    """Online refit of the profiled step costs from real decode steps.
+
+    A step of `R` requests and `n` tokens over `x` thousand KV tokens costs
+    `base(R, n) + extra`, `base` the profiled draft + verify tables. The
+    profile misses what real text routes to (fewer experts than random ids)
+    and how attention grows with context: it is nearly constant in `n`, so
+    long contexts make wide verification cheaper per token. The residual is
+    fitted as `mean_r[R, n] + slope * (x - mean_x[R, n])`: per-(R, n) EMAs
+    and one slope, a forgetting regression of the residuals on the context
+    within each (R, n), regularized toward the profiled slope. Unobserved
+    sizes take the profiled cost plus the slope past the profile context.
+
+    A step's cost is the time from its forward start to the next one's (GPU
+    events, polled with `query()`: no host sync). Samples outside
+    [0.5, 2] x the prediction (idle gaps, GC pauses) are dropped.
+    """
+
+    EMA = 0.05
+    # Weight of the profiled slope, in (thousand tokens)^2 of context spread.
+    SLOPE_PRIOR = 2000.0
+    FORGET = 0.999
+
+    def __init__(
+        self,
+        max_reqs: int,
+        max_tokens: int,
+        slope_ms_per_ktok: float,
+        profile_ktok_per_req: float,
+    ):
+        shape = (max_reqs + 1, max_tokens + 1)
+        self.slope0 = self.slope = max(0.0, slope_ms_per_ktok)
+        self.profile_ktok_per_req = profile_ktok_per_req
+        self.mean_x = np.zeros(shape)
+        self.mean_r = np.zeros(shape)
+        self.seen = np.zeros(shape, dtype=bool)
+        self._sxx = 0.0
+        self._sxy = 0.0
+        self._pending: deque = deque()
+        self._free: list[torch.Event] = []
+        self._last: tuple | None = None
+        self.num_obs = 0
+        self.num_rejected = 0
+
+    def extra(self, num_reqs: int, sizes: np.ndarray, ktok: float) -> np.ndarray:
+        """Cost (ms) to add to the profiled cost of each size in `sizes`."""
+        seen = self.seen[num_reqs, sizes]
+        fitted = self.mean_r[num_reqs, sizes] + self.slope * (
+            ktok - self.mean_x[num_reqs, sizes]
+        )
+        prior = self.slope * (ktok - num_reqs * self.profile_ktok_per_req)
+        return np.where(seen, fitted, prior)
+
+    def step_start(
+        self, num_reqs: int, num_tokens: int, ktok: float, base: float, pred: float
+    ) -> None:
+        """Record a decode step's start, which ends the previous step."""
+        event = self._free.pop() if self._free else torch.Event(enable_timing=True)
+        event.record()
+        if self._last is not None:
+            self._pending.append((*self._last, event))
+        self._last = (event, num_reqs, num_tokens, ktok, base, pred)
+
+    def break_chain(self) -> None:
+        """The next timed step does not directly follow the last one."""
+        if self._last is not None:
+            self._free.append(self._last[0])
+        self._last = None
+
+    def poll(self) -> None:
+        while self._pending and self._pending[0][-1].query():
+            start, num_reqs, n, ktok, base, pred, end = self._pending.popleft()
+            self._free.append(start)
+            self.observe(num_reqs, n, ktok, start.elapsed_time(end), base, pred)
+
+    def observe(
+        self, num_reqs: int, n: int, ktok: float, ms: float, base: float, pred: float
+    ) -> None:
+        if not 0.5 * pred <= ms <= 2.0 * pred:
+            self.num_rejected += 1
+            return
+        self.num_obs += 1
+        r = ms - base
+        if not self.seen[num_reqs, n]:
+            self.seen[num_reqs, n] = True
+            self.mean_x[num_reqs, n] = ktok
+            self.mean_r[num_reqs, n] = r
+            return
+        dx = ktok - self.mean_x[num_reqs, n]
+        dr = r - self.mean_r[num_reqs, n]
+        self._sxx = self._sxx * self.FORGET + dx * dx
+        self._sxy = self._sxy * self.FORGET + dx * dr
+        self.slope = max(
+            0.0,
+            (self.SLOPE_PRIOR * self.slope0 + self._sxy)
+            / (self.SLOPE_PRIOR + self._sxx),
+        )
+        self.mean_x[num_reqs, n] += self.EMA * dx
+        self.mean_r[num_reqs, n] += self.EMA * dr
+

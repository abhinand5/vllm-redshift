+    def step_started(self, num_tokens: int, timed: bool) -> None:
+        """Called at each forward start: time it if it runs the budget chosen
+        this step (`timed`: a FULL cudagraph decode step), else break the
+        chain of back-to-back steps."""
+        online, choice, self._step_choice = self.online, self._step_choice, None
+        if online is None:
+            return
+        if not timed or choice is None or choice[1] != num_tokens:
+            online.break_chain()
+            return
+        online.step_start(*choice)
+
+    def _log_choice(self, draft_budget: int) -> None:
+        if not _STATS_EVERY:
+            return
+        if draft_budget >= self._width_counts.shape[0]:
+            self._width_counts = np.pad(
+                self._width_counts, (0, draft_budget + 1 - self._width_counts.shape[0])
+            )
+        self._width_counts[draft_budget] += 1
+        self._num_choices += 1
+        if self._num_choices % _STATS_EVERY:
+            return
+        online = self.online
+        logger.info(
+            "DSpark adaptive verification: draft budgets chosen %s; online fit: "
+            "%s samples (%s dropped), slope %.4f ms/1K",
+            {b: int(c) for b, c in enumerate(self._width_counts) if c},
+            online.num_obs if online else 0,
+            online.num_rejected if online else 0,
+            online.slope if online else 0.0,
+        )
+        self._width_counts[:] = 0

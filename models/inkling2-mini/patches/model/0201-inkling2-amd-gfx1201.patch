+        mode,
+        num_warps=num_warps,
+    )
+    return out if batched else out[0]
+
+
+def decode_linear(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """`nn.functional.linear(x, weight)` (no bias). bf16 decode inputs take
+    the Triton GEMVs, which read the weight faster than hipBLASLt there: one
+    row (batch-1 decode) `gemv`, 2..16 rows (spec-decode verify windows)
+    `gemv_rows`; prefill stays on hipBLASLt."""
+    if (
+        x.dim() == 2
+        and 1 <= x.shape[0] <= GEMV_ROWS_MAX
+        and x.dtype == weight.dtype == torch.bfloat16
+        and x.stride(-1) == 1
+        and weight.stride(-1) == 1
+    ):
+        return gemv(x, weight) if x.shape[0] == 1 else gemv_rows(x, weight)
+    return torch.nn.functional.linear(x, weight)
+
+
+@triton.jit
+def _fp8_rows_kernel(
+    X,
+    W,
+    Scale,
+    Bias,
+    Y,
+    M,
+    N,
+    stride_xm,
+    stride_wn,
+    stride_ym,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+    Base=None,
+    stride_bm=0,
+    softcap=1.0,
+    SOFTCAP: tl.constexpr = False,
+):
+    # `SOFTCAP`: `ops.dspark.add_softcap(Base, y, softcap)` of the bf16 `y`.
+    # One program: BN output columns for all M (<= BM) rows. The e4m3 weight
+    # bytes are decoded exactly to fp16 (2^-8 times their value) and fed to
+    # the matrix cores with the fp16 rows of x; fp32 accumulation, then the
+    # per-column scale (times 2^8) and the optional bias.
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    rows = tl.arange(0, BM)
+    col_ok = cols < N
+    w_rows = W.to(tl.pointer_type(tl.uint16)) + cols[:, None].to(tl.int64) * (
+        stride_wn // 2
+    )
+    x_rows = X + rows[:, None] * stride_xm
+    acc = tl.zeros((BM, BN), tl.float32)
+    for k0 in range(0, K, BK):
+        ks = k0 + tl.arange(0, BK)
+        x_ok = (rows[:, None] < M) & (ks[None, :] < K)
+        x = tl.load(x_rows + ks[None, :], x_ok, other=0).to(tl.float16)
+        pairs = k0 // 2 + tl.arange(0, BK // 2)
+        w_ok = col_ok[:, None] & (pairs[None, :] < K // 2)
+        codes = tl.load(w_rows + pairs[None, :], w_ok, other=0)
+        w = _e4m3_to_f16(codes, BN, BK // 2)
+        acc = tl.dot(x, tl.trans(w), acc)
+    scale = tl.load(Scale + cols, col_ok, other=0.0) * 256.0
+    acc = acc * scale[None, :]
+    if HAS_BIAS:
+        acc += tl.load(Bias + cols, col_ok, other=0.0).to(tl.float32)[None, :]
+    out_ok = (rows[:, None] < M) & col_ok[None, :]
+    if SOFTCAP:
+        base = tl.load(Base + rows[:, None] * stride_bm + cols[None, :], out_ok, other=0)
+        x = (base.to(tl.float32) + acc.to(tl.bfloat16).to(tl.float32)).to(tl.bfloat16)
+        x = x / softcap
+        x = tldevice.tanh(x)
+        acc = x * softcap
+    tl.store(
+        Y + rows[:, None] * stride_ym + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        out_ok,
+    )
+
+
+FP8_ROWS_MAX = 16
+
+
+def quantize_fp8_rows(weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """e4m3 `(N, K)` weight with one fp32 scale per row (absmax / 448), the
+    format `fp8_rows_linear` reads. Rows are converted in chunks."""
+    n = weight.shape[0]
+    q = torch.empty(weight.shape, dtype=torch.float8_e4m3fn, device=weight.device)
+    scale = torch.empty(n, dtype=torch.float32, device=weight.device)
+    for start in range(0, n, 8192):
+        rows = weight[start : start + 8192].float()
+        s = rows.abs().amax(1).clamp_min(1e-30) / 448.0
+        q[start : start + 8192] = (rows / s[:, None]).to(torch.float8_e4m3fn)
+        scale[start : start + 8192] = s
+    return q, scale
+
+
+def fp8_rows_linear(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    scale: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    out_dtype: torch.dtype | None = None,
+    block_n: int | None = None,
+    num_warps: int = 4,
+    softcap_base: torch.Tensor | None = None,
+    softcap: float = 1.0,
+) -> torch.Tensor:
+    """`x @ (weight * scale[:, None]).T (+ bias)` for 1..16 bf16 rows `x`
+    `(M, K)` over an e4m3 `weight` `(N, K)` from `quantize_fp8_rows`. `x` is
+    rounded to fp16 (exact for bf16 values within the fp16 range). With
+    bf16 `softcap_base` `(M, N)`: `add_softcap(softcap_base, y, softcap)`
+    of the bf16 result `y`, bit for bit."""
+    m, k = x.shape
+    n = weight.shape[0]
+    assert 1 <= m <= FP8_ROWS_MAX and weight.shape == (n, k) and k % 2 == 0
+    assert x.stride(-1) == 1 and weight.stride(-1) == 1 and weight.stride(0) % 2 == 0
+    assert weight.dtype == torch.float8_e4m3fn and scale.shape == (n,)
+    if softcap_base is not None:
+        assert softcap_base.shape == (m, n) and softcap_base.stride(-1) == 1
+        assert softcap_base.dtype == torch.bfloat16 and (out_dtype or x.dtype) == torch.bfloat16
+    out = torch.empty((m, n), dtype=out_dtype or x.dtype, device=x.device)
+    bk = 256 if k % 256 == 0 else triton.next_power_of_2(k)
+    bn = block_n or 64
+    _fp8_rows_kernel[(triton.cdiv(n, bn),)](
+        x,
+        weight,
+        scale,
+        scale if bias is None else bias,
+        out,
+        m,
+        n,
+        x.stride(0),
+        weight.stride(0),
+        out.stride(0),
+        k,
+        16,
+        bn,
+        bk,
+        bias is not None,
+        softcap_base,
+        0 if softcap_base is None else softcap_base.stride(0),
+        softcap,
+        softcap_base is not None,
+        num_warps=num_warps,
+    )
+    return out

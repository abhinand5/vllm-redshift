diff --git a/vllm/models/inkling2/amd/ops/nvfp4_moe.py b/vllm/models/inkling2/amd/ops/nvfp4_moe.py
new file mode 100644
index 0000000000..d1083fe560
--- /dev/null
+++ b/vllm/models/inkling2/amd/ops/nvfp4_moe.py
@@ -0,0 +1,876 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Triton NVFP4 batched expert GEMMs for the Inkling2 MoE on gfx12.
+
+Same contract as `triton_bmm.bmm` (expert-sorted, tile-padded MXFP8 activation
+rows with block scales in the R8c4 / R128c4 layout of `mxfp8`, routing `tiles`
+of `moe.route`), with NVFP4 expert weights exactly as stored in the
+checkpoint: `weight` uint8 [E, N, K / 2] (two e2m1 codes per byte, low nibble
+= even k), `weight_scale` e4m3 [E, N, K / 16], `amax` fp32 [E] and
+`denominator` fp32 [1]:
+
+    w[e, n, k] = e2m1(weight) * weight_scale[e, n, k // 16] * amax[e] / denominator
+
+with the outer scale `amax[e] / denominator` applied to each output row's fp32
+accumulator, as NVIDIA's GEMMs and `nvfp4_ref.nvfp4_bmm_reference` do.
+
+RDNA4 has no FP4 or block-scaled matrix instructions. The kernel decodes
+both operands to fp16 in registers with a few integer ops per 4 bytes (inline
+asm: Triton lowers 8-bit ops element by element on gfx12) and runs fp16 x
+fp16 -> fp32 WMMA per 32-wide K group (one activation scale block). Weights
+are decoded with their e4m3 block scales folded in, which is exact in fp16
+(e2m1 x e4m3 has at most 6 significant bits); the ue8m0 activation scales
+scale each group's fp32 partial sum. Every product is exact, so the result
+equals the fp32 reference up to the order of the fp32 additions. No host
+syncs: the grid is the plan's upper bound and programs past the routed tiles
+return, so the GEMM can be captured in a HIP graph.
+
+Decode plans (a row or two per expert) run `gemv` instead: no WMMA, fp16
+pair dots (v_dot2_f32_f16) of the same exact decodes, the block scales on
+the fp32 sums of 8 products, closer to the memory bandwidth.
+"""
+
+import functools
+import os
+from dataclasses import dataclass
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+from .activation import _sigmoid_approx, _softcap
+from .mxfp8 import _scale_offsets
+from .triton_bmm import ExpertPlan, _e8m0_to_f32
+
+# Inline asm for gfx12 (pack=2: one VGPR $N holds two 16-bit elements, i.e.
+# 4 consecutive bytes b0..b3). Triton lowers fp8 / 8-bit integer ops element
+# by element on this target; these decode two values per instruction.
+#
+# NVFP4: the 8 codes of b0..b3 (two uint16 elements b0 b1 | b2 b3; low nibble
+# = even k) -> fp16 pairs times the fp16 block scale pair $5, per element
+# $0 = low nibble of its first byte, $1 = high nibble of it, $2, $3 = the
+# same for its second byte; $4 is scratch. A code's fp16 bits (worth 2^-14
+# times its e2m1 value, subnormals included) are its 3 magnitude bits at
+# 9-11 and its sign at 15, i.e. only a high byte: first all 8 high bytes
+# (low nibbles to $0, high to $4, one per byte), then each fp16 pair is a
+# byte permute with zero low bytes. The products e2m1 * e4m3 * 2^-14 have at
+# most 6 significant bits and are multiples of 2^-24 below 2^-2: exact fp16.
+_NVFP4_TO_F16 = tl.constexpr(
+    """
+    v_lshlrev_b32 $4, 4, $5
+    v_lshlrev_b32 $0, 1, $5
+    v_and_b32 $0, 0x0e0e0e0e, $0
+    v_and_or_b32 $0, $4, 0x80808080, $0
+    v_lshrrev_b32 $4, 3, $5
+    v_and_b32 $4, 0x0e0e0e0e, $4
+    v_and_or_b32 $4, $5, 0x80808080, $4
+    v_perm_b32 $1, $4, $0, 0x050c010c
+    v_perm_b32 $2, $4, $0, 0x060c020c
+    v_perm_b32 $3, $4, $0, 0x070c030c
+    v_perm_b32 $0, $4, $0, 0x040c000c
+    v_pk_mul_f16 $0, $0, $6
+    v_pk_mul_f16 $1, $1, $6
+    v_pk_mul_f16 $2, $2, $6
+    v_pk_mul_f16 $3, $3, $6
+    """
+)
+# e4m3: b0..b3 -> fp16 pairs $0 = (b0, b2), $1 = (b1, b3), each worth 2^-8
+# times the e4m3 value (exponent and mantissa shifted into fp16's fields;
+# e4m3 subnormals become fp16 subnormals). Exact for finite e4m3 (the NaN
+# code 0x7f becomes a finite value).
+_E4M3_TO_F16 = tl.constexpr(
+    """
+    v_lshlrev_b32 $1, 8, $2
+    v_lshlrev_b32 $0, 7, $2
+    v_and_b32 $0, 0x3f803f80, $0
+    v_and_or_b32 $0, $1, 0x80008000, $0
+    v_lshrrev_b32 $1, 1, $2
+    v_and_b32 $1, 0x3f803f80, $1
+    v_and_or_b32 $1, $2, 0x80008000, $1
+    """
+)
+
+
+@triton.jit
+def _e4m3_to_f32(x):
+    """fp32 value of the (finite) e4m3 bytes `x`, exactly (see
+    `_E4M3_TO_F16`). Avoids the compare/select chain Triton emits for
+    fp8 -> fp32 on gfx12."""
+    x = x.to(tl.uint8, bitcast=True).to(tl.uint16)
+    h = ((x & 0x80) << 8) | ((x & 0x7F) << 7)
+    return h.to(tl.float16, bitcast=True).to(tl.float32) * 256.0
+
+
+@triton.jit
+def _e4m3_to_f16(x, R: tl.constexpr, C: tl.constexpr):
+    """fp16 [R, 2 C]: 2^-8 times the e4m3 values whose byte pairs are the
+    uint16 `x` [R, C] (little endian), exactly."""
+    even, odd = tl.inline_asm_elementwise(
+        _E4M3_TO_F16,
+        "=&v,=&v,v",
+        [x.to(tl.uint16, bitcast=True)],
+        dtype=(tl.float16, tl.float16),
+        is_pure=True,
+        pack=2,
+    )
+    return tl.join(even, odd).reshape(R, 2 * C)
+
+
+@triton.jit
+def _nvfp4_to_f16(codes, scale, BN: tl.constexpr, BK: tl.constexpr):
+    """fp16 [BN, BK]: 2^-14 times the e2m1 values of the packed codes
+    `codes` uint16 [BN, BK / 4] (bytes little endian, low nibble = even k)
+    times their fp16 block `scale` [BN, BK / 16], exactly."""
+    scale = tl.broadcast_to(scale[:, :, None], (BN, BK // 16, 4)).reshape(BN, BK // 4)
+    k0, k1, k2, k3, _ = tl.inline_asm_elementwise(
+        _NVFP4_TO_F16,
+        "=&v,=&v,=&v,=&v,=&v,v,v",
+        [codes.to(tl.uint16, bitcast=True), scale],
+        dtype=(tl.float16,) * 5,
+        is_pure=True,
+        pack=2,
+    )
+    # Registers hold (k, k + 1) pairs: o_j[2i + p] = k(8 i + 2 j + p).
+    t = tl.join(
+        tl.join(k0.reshape(BN, BK // 8, 2), k2.reshape(BN, BK // 8, 2)),
+        tl.join(k1.reshape(BN, BK // 8, 2), k3.reshape(BN, BK // 8, 2)),
+    )
+    return tl.permute(t, (0, 1, 3, 4, 2)).reshape(BN, BK)
+
+
+@triton.jit
+def _nvfp4_bmm_kernel(
+    A,
+    AScale,
+    W,
+    WScale,
+    Amax,
+    Denominator,
+    Out,
+    Tiles,
+    max_ctas,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    TILE: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+):
+    # Program (n, m) computes BM rows of token tile m // SUB (a part of it,
+    # or the whole tile when it has fewer than BM rows); only routed rows
+    # are read and written. BK (a multiple of 32) is the K step of the loop;
+    # its 32-wide activation scale groups are unrolled, one fp16 dot each:
+    # weights decoded with their block scales folded in (exact), activations
+    # decoded without theirs, which scale the fp32 partial sums.
+    SUB: tl.constexpr = TILE // BM if TILE >= BM else 1
+    pid_m = tl.program_id(1)
+    tile = pid_m // SUB
+    if tile >= tl.load(Tiles + 2 * max_ctas):
+        return
+    row_end = tl.load(Tiles + max_ctas + tile)
+    row0 = tile * TILE + (pid_m % SUB) * BM
+    if row0 >= row_end:
+        return
+    expert = tl.load(Tiles + tile).to(tl.int64)
+    rows = row0 + tl.arange(0, BM)
+    in_tile = rows < row_end
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    # A and W as int16 (byte pairs).
+    a_ptrs = A + rows[:, None].to(tl.int64) * (K // 2) + tl.arange(0, 16)[None, :]
+    w_ptrs = W + (expert * N + cols[:, None]) * (K // 4) + tl.arange(0, 8)[None, :]
+    ws_ptrs = (
+        WScale + (expert * N + cols[:, None]) * (K // 16) + tl.arange(0, 2)[None, :]
+    )
+    acc = tl.zeros((BM, BN), tl.float32)
+    for k in range(0, K, BK):
+        for g in tl.static_range(BK // 32):
+            kg = k + g * 32
+            # Unmasked: rows past the routed ones are the (allocated) tile
+            # padding and only reach their own, unstored, output rows.
+            a = _e4m3_to_f16(tl.load(a_ptrs + kg // 2), BM, 16)
+            a_scale = tl.load(AScale + _scale_offsets(rows, kg // 32, K // 32, TILE))
+            w_scale = _e4m3_to_f32(tl.load(ws_ptrs + kg // 16)).to(tl.float16)
+            w = _nvfp4_to_f16(tl.load(w_ptrs + kg // 4), w_scale, BN, 32)
+            part = tl.dot(a, tl.trans(w))
+            acc += part * _e8m0_to_f32(a_scale)[:, None]
+    # 2^22 undoes the decodes' 2^-8 (activations) and 2^-14 (weights); then
+    # the outer scale in fp32.
+    outer = tl.div_rn(tl.load(Amax + expert), tl.load(Denominator))
+    out = (acc * 4194304.0) * outer
+    out_ptrs = Out + rows[:, None].to(tl.int64) * N + cols[None, :]
+    tl.store(out_ptrs, out.to(tl.bfloat16), in_tile[:, None])
+
+
+# Decode (a row or two per expert): a GEMV-style kernel without WMMA, so no
+# layout conversions through LDS between the loads and the math, and the
+# whole K unrolled so that a thread has many loads in flight. A thread takes
+# whole 32-wide K groups (one activation scale block): 4 codes words (16
+# bytes) with their block scale bytes. A codes word (8 codes k0..k7, low
+# nibble = even k) decodes to the fp16 pairs (k0, k2), (k1, k3), (k4, k6),
+# (k5, k7), 2^-14 times the e2m1 values (as in `_NVFP4_TO_F16`, fp16
+# subnormals below 1); the word's 8 activation bytes decode to the same
+# pairs (`_E4M3_TO_F16`) and v_dot2_f32_f16 sums the 8 exact products in
+# fp32. The word's e4m3 block scale (shared by the 16-wide block) then
+# scales that fp32 sum, the activation scale the group's sum.
+#
+# $5 = codes word; $0..$3 the pairs, $4 scratch.
+_NVFP4_WORD_TO_F16 = tl.constexpr(
+    """
+    v_lshlrev_b32 $4, 4, $5
+    v_lshlrev_b32 $0, 1, $5
+    v_and_b32 $0, 0x0e0e0e0e, $0
+    v_and_or_b32 $0, $4, 0x80808080, $0
+    v_lshrrev_b32 $4, 3, $5
+    v_and_b32 $4, 0x0e0e0e0e, $4
+    v_and_or_b32 $4, $5, 0x80808080, $4
+    v_perm_b32 $1, $4, $0, 0x050c040c
+    v_perm_b32 $2, $4, $0, 0x030c020c
+    v_perm_b32 $3, $4, $0, 0x070c060c
+    v_perm_b32 $0, $4, $0, 0x010c000c
+    """
+)
+# Sum of the 4 pair products: weights $1..$4, activations $5..$8.
+_DOT8 = tl.constexpr(
+    """
+    v_dot2_f32_f16 $0, $1, $5, 0
+    v_dot2_f32_f16 $0, $2, $6, $0
+    v_dot2_f32_f16 $0, $3, $7, $0
+    v_dot2_f32_f16 $0, $4, $8, $0
+    """
+)
+
+
+@triton.jit
+def _nvfp4_gemv_groups(
+    w_row,
+    s_row,
+    a_row,
+    AScale,
+    row,
+    k,
+    KG: tl.constexpr,
+    TILE: tl.constexpr,
+    G: tl.constexpr,
+):
+    """fp32 [BN]: 2^-22 times the dot products over the 32-wide K groups
+    k .. k + G - 1 (those below KG) of BN weight rows (`w_row` int32 and
+    `s_row` uint8 [BN, 1, 1] pointers) with activation row `row` (`a_row`,
+    int64)."""
+    g = tl.arange(0, G)
+    g_in = (k + g) < KG
+    words = (k + g)[None, :, None] * 4 + tl.arange(0, 4)[None, None, :]
+    c = tl.load(w_row + words, g_in[None, :, None], other=0)
+    # One block scale byte per codes word: a load of the weights' shape and
+    # order, which Triton gives the weights' layout (no conversion).
+    s = tl.load(s_row + words // 2, g_in[None, :, None], other=0)
+    w0, w1, w2, w3, _ = tl.inline_asm_elementwise(
+        _NVFP4_WORD_TO_F16,
+        "=&v,=&v,=&v,=&v,=&v,v",
+        [c],
+        dtype=(tl.int32,) * 5,
+        is_pure=True,
+        pack=1,
+    )
+    # Unmasked rows: past the routed ones they are the (allocated) tile
+    # padding and only reach their own, unstored, output rows.
+    a = tl.load(a_row + words, g_in[None, :, None], other=0)
+    a0, a1 = tl.inline_asm_elementwise(
+        _E4M3_TO_F16,
+        "=&v,=&v,v",
+        [a.to(tl.int32)],
+        dtype=(tl.int32, tl.int32),
+        is_pure=True,
+        pack=1,
+    )
+    a2, a3 = tl.inline_asm_elementwise(
+        _E4M3_TO_F16,
+        "=&v,=&v,v",
+        [(a >> 32).to(tl.int32)],
+        dtype=(tl.int32, tl.int32),
+        is_pure=True,
+        pack=1,
+    )
+    part = tl.inline_asm_elementwise(
+        _DOT8,
+        "=&v,v,v,v,v,v,v,v,v",
+        [w0, w1, w2, w3, a0, a1, a2, a3],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    part = part * _e4m3_to_f32(s)
+    a_scale = tl.load(AScale + _scale_offsets(row, k + g, KG, TILE), g_in, other=0)
+    # Masked groups: zero codes and activations give 0 * 2^-127.
+    return tl.sum(tl.sum(part, 2) * _e8m0_to_f32(a_scale)[None, :], 1)
+
+
+@triton.jit
+def _nvfp4_gemv_kernel(
+    A,
+    AScale,
+    W,
+    WScale,
+    Amax,
+    Denominator,
+    Out,
+    Tiles,
+    max_ctas,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    TILE: tl.constexpr,
+    BN: tl.constexpr,
+    G0: tl.constexpr,
+    G: tl.constexpr,
+):
+    # Program (n, t): BN output columns of token tile t, its routed rows one
+    # at a time (weights re-read from cache past the first), the whole K
+    # unrolled: G0 groups first (one wide load), the rest in steps of G.
+    # `A` as int64 (the 8 activation bytes of a codes word), `W` as int32
+    # (8 codes), `WScale` as uint8.
+    tile = tl.program_id(1)
+    if tile >= tl.load(Tiles + 2 * max_ctas):
+        return
+    row_end = tl.load(Tiles + max_ctas + tile)
+    expert = tl.load(Tiles + tile).to(tl.int64)
+    KG: tl.constexpr = K // 32
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    w_row = W + ((expert * N + cols) * (K // 8))[:, None, None]
+    s_row = WScale + ((expert * N + cols) * (K // 16))[:, None, None]
+    outer = tl.div_rn(tl.load(Amax + expert), tl.load(Denominator))
+    for row in range(tile * TILE, row_end):
+        a_row = A + row.to(tl.int64) * (K // 8)
+        acc = _nvfp4_gemv_groups(w_row, s_row, a_row, AScale, row, 0, KG, TILE, G0)
+        for k in tl.static_range(G0, KG, G):
+            acc += _nvfp4_gemv_groups(w_row, s_row, a_row, AScale, row, k, KG, TILE, G)
+        # 2^22 undoes the decodes' 2^-8 (activations) and 2^-14 (weights).
+        out = (acc * 4194304.0) * outer
+        tl.store(Out + row.to(tl.int64) * N + cols, out.to(tl.bfloat16))
+
+
+@triton.jit
+def _f16_pair_slot(k):
+    """Position of activation `k` in the fp16 pair layout: in each run of 8,
+    k0 k2 k1 k3 k4 k6 k5 k7, the pairs a decoded codes word dots with."""
+    return (k & ~7) | (k & 4) | ((k & 1) << 1) | ((k >> 1) & 1)
+
+
+@triton.jit
+def _nvfp4_gemv_f16_groups(w_row, s_row, a_row, k, KG: tl.constexpr, G: tl.constexpr):
+    """`_nvfp4_gemv_groups` with unquantized activations: `a_row` (int64)
+    is an fp16 row in the `_f16_pair_slot` layout. fp32 [BN], 2^-14 times
+    the dot products."""
+    g = tl.arange(0, G)
+    g_in = (k + g) < KG
+    words = (k + g)[None, :, None] * 4 + tl.arange(0, 4)[None, None, :]
+    c = tl.load(w_row + words, g_in[None, :, None], other=0)
+    s = tl.load(s_row + words // 2, g_in[None, :, None], other=0)
+    w0, w1, w2, w3, _ = tl.inline_asm_elementwise(
+        _NVFP4_WORD_TO_F16,
+        "=&v,=&v,=&v,=&v,=&v,v",
+        [c],
+        dtype=(tl.int32,) * 5,
+        is_pure=True,
+        pack=1,
+    )
+    # A codes word's 8 activations: 16 bytes, its 4 fp16 pairs.
+    lo = tl.load(a_row + 2 * words, g_in[None, :, None], other=0)
+    hi = tl.load(a_row + 2 * words + 1, g_in[None, :, None], other=0)
+    part = tl.inline_asm_elementwise(
+        _DOT8,
+        "=&v,v,v,v,v,v,v,v,v",
+        [
+            w0,
+            w1,
+            w2,
+            w3,
+            lo.to(tl.int32),
+            (lo >> 32).to(tl.int32),
+            hi.to(tl.int32),
+            (hi >> 32).to(tl.int32),
+        ],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    return tl.sum(tl.sum(part * _e4m3_to_f32(s), 2), 1)
+
+
+@triton.jit
+def _nvfp4_gemv_f16_kernel(
+    A,
+    RowToken,
+    W,
+    WScale,
+    Amax,
+    Denominator,
+    Out,
+    Gammas,
+    Tiles,
+    max_ctas,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    TILE: tl.constexpr,
+    BN: tl.constexpr,
+    G0: tl.constexpr,
+    G: tl.constexpr,
+    BY_TOKEN: tl.constexpr,
+    SITU: tl.constexpr,
+    GATE_CAP: tl.constexpr,
+    UP_CAP: tl.constexpr,
+):
+    # `_nvfp4_gemv_kernel` with bf16-valued activations held as fp16 in the
+    # `_f16_pair_slot` layout (no activation scales). `BY_TOKEN`: layout row
+    # r reads activation row `RowToken[r]` (w13 reads the token rows).
+    # `SITU`: the output is w13's interleaved (gate, up) columns; store the
+    # bf16-rounded SiTU (as `activation._situ`) times the row's routing
+    # weight in the same layout: `Out` is fp16 [rows, N // 2].
+    tile = tl.program_id(1)
+    if tile >= tl.load(Tiles + 2 * max_ctas):
+        return
+    row_end = tl.load(Tiles + max_ctas + tile)
+    expert = tl.load(Tiles + tile).to(tl.int64)
+    KG: tl.constexpr = K // 32
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    w_row = W + ((expert * N + cols) * (K // 8))[:, None, None]
+    s_row = WScale + ((expert * N + cols) * (K // 16))[:, None, None]
+    outer = tl.div_rn(tl.load(Amax + expert), tl.load(Denominator))
+    for row in range(tile * TILE, row_end):
+        a_index = tl.load(RowToken + row) if BY_TOKEN else row
+        a_row = A + a_index.to(tl.int64) * (K // 4)
+        acc = _nvfp4_gemv_f16_groups(w_row, s_row, a_row, 0, KG, G0)
+        for k in tl.static_range(G0, KG, G):
+            acc += _nvfp4_gemv_f16_groups(w_row, s_row, a_row, k, KG, G)
+        # 2^14 undoes the weights' decode (2^-14).
+        out = ((acc * 16384.0) * outer).to(tl.bfloat16)
+        if SITU:
+            gate, up = tl.split(tl.reshape(out.to(tl.float32), (BN // 2, 2)))
+            sigmoid = _sigmoid_approx(gate)
+            gate = _softcap(gate, GATE_CAP)
+            up = _softcap(up, UP_CAP)
+            y = ((gate * sigmoid) * up) * tl.load(Gammas + row)
+            j = tl.program_id(0) * (BN // 2) + tl.arange(0, BN // 2)
+            tl.store(
+                Out + row.to(tl.int64) * (N // 2) + _f16_pair_slot(j),
+                y.to(tl.bfloat16).to(tl.float16),
+            )
+        else:
+            tl.store(Out + row.to(tl.int64) * N + cols, out)
+
+
+@triton.jit
+def _nvfp4_gemv_f16_chunk(w_row, s_row, a_row, k, KG: tl.constexpr, G: tl.constexpr):
+    """Weights of K groups k .. k + G - 1, decoded once: the 4 fp16 pair
+    words of each codes word and its block scale (fp32), [BN, G, 4]."""
+    g = tl.arange(0, G)
+    g_in = (k + g) < KG
+    words = (k + g)[None, :, None] * 4 + tl.arange(0, 4)[None, None, :]
+    c = tl.load(w_row + words, g_in[None, :, None], other=0)
+    s = tl.load(s_row + words // 2, g_in[None, :, None], other=0)
+    w0, w1, w2, w3, _ = tl.inline_asm_elementwise(
+        _NVFP4_WORD_TO_F16,
+        "=&v,=&v,=&v,=&v,=&v,v",
+        [c],
+        dtype=(tl.int32,) * 5,
+        is_pure=True,
+        pack=1,
+    )
+    return w0, w1, w2, w3, _e4m3_to_f32(s), words, g_in
+
+
+@triton.jit
+def _nvfp4_gemv_f16_rows_kernel(
+    A,
+    RowToken,
+    W,
+    WScale,
+    Amax,
+    Denominator,
+    Out,
+    Gammas,
+    Tiles,
+    max_ctas,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    TILE: tl.constexpr,
+    BN: tl.constexpr,
+    G0: tl.constexpr,
+    G1: tl.constexpr,
+    G: tl.constexpr,
+    R: tl.constexpr,
+    BY_TOKEN: tl.constexpr,
+    SITU: tl.constexpr,
+    GATE_CAP: tl.constexpr,
+    UP_CAP: tl.constexpr,
+):
+    # `_nvfp4_gemv_f16_kernel` for verify widths: a tile of one routed row
+    # takes the same whole-K path (G0 groups at once); a tile of several
+    # rows (up to R) decodes each G-group chunk of the weights once and dots
+    # it with every row, accumulating [R, BN].
+    tile = tl.program_id(1)
+    if tile >= tl.load(Tiles + 2 * max_ctas):
+        return
+    row0 = tile * TILE
+    n_rows = tl.load(Tiles + max_ctas + tile) - row0
+    expert = tl.load(Tiles + tile).to(tl.int64)
+    KG: tl.constexpr = K // 32
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    w_row = W + ((expert * N + cols) * (K // 8))[:, None, None]
+    s_row = WScale + ((expert * N + cols) * (K // 16))[:, None, None]
+    outer = tl.div_rn(tl.load(Amax + expert), tl.load(Denominator))
+    ridx = tl.arange(0, R)
+    if n_rows == 1:
+        a_index = tl.load(RowToken + row0) if BY_TOKEN else row0
+        a_row = A + a_index.to(tl.int64) * (K // 4)
+        acc1 = _nvfp4_gemv_f16_groups(w_row, s_row, a_row, 0, KG, G0)
+        for k in tl.static_range(G0, KG, G1):
+            acc1 += _nvfp4_gemv_f16_groups(w_row, s_row, a_row, k, KG, G1)
+        acc = tl.where(ridx[:, None] == 0, acc1[None, :], 0.0)
+    else:
+        acc = tl.zeros((R, BN), tl.float32)
+        for k in tl.static_range(0, KG, G):
+            w0, w1, w2, w3, sc, words, g_in = _nvfp4_gemv_f16_chunk(
+                w_row, s_row, A, k, KG, G
+            )
+            for r in range(n_rows):
+                a_index = tl.load(RowToken + row0 + r) if BY_TOKEN else row0 + r
+                a_row = A + a_index.to(tl.int64) * (K // 4)
+                lo = tl.load(a_row + 2 * words, g_in[None, :, None], other=0)
+                hi = tl.load(a_row + 2 * words + 1, g_in[None, :, None], other=0)
+                part = tl.inline_asm_elementwise(
+                    _DOT8,
+                    "=&v,v,v,v,v,v,v,v,v",
+                    [
+                        w0,
+                        w1,
+                        w2,
+                        w3,
+                        lo.to(tl.int32),
+                        (lo >> 32).to(tl.int32),
+                        hi.to(tl.int32),
+                        (hi >> 32).to(tl.int32),
+                    ],
+                    dtype=tl.float32,
+                    is_pure=True,
+                    pack=1,
+                )
+                p = tl.sum(tl.sum(part * sc, 2), 1)
+                acc = tl.where(ridx[:, None] == r, acc + p[None, :], acc)
+    for r in range(n_rows):
+        row = row0 + r
+        acc_r = tl.sum(tl.where(ridx[:, None] == r, acc, 0.0), 0)
+        out = ((acc_r * 16384.0) * outer).to(tl.bfloat16)
+        if SITU:
+            gate, up = tl.split(tl.reshape(out.to(tl.float32), (BN // 2, 2)))
+            sigmoid = _sigmoid_approx(gate)
+            gate = _softcap(gate, GATE_CAP)
+            up = _softcap(up, UP_CAP)
+            y = ((gate * sigmoid) * up) * tl.load(Gammas + row)
+            j = tl.program_id(0) * (BN // 2) + tl.arange(0, BN // 2)
+            tl.store(
+                Out + row.to(tl.int64) * (N // 2) + _f16_pair_slot(j),
+                y.to(tl.bfloat16).to(tl.float16),
+            )
+        else:
+            tl.store(Out + row.to(tl.int64) * N + cols, out)
+
+
+def gemv_f16(
+    act: torch.Tensor,
+    row_token: torch.Tensor | None,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    amax: torch.Tensor,
+    denominator: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+    situ: tuple[torch.Tensor, float, float] | None = None,
+) -> torch.Tensor:
+    """Decode expert GEMV with bf16-valued activations `act` (fp16 in the
+    `_f16_pair_slot` layout): token rows read through `row_token` (layout
+    row -> token), else layout rows. bf16 `[plan.rows, N]`, or with `situ =
+    (gammas, gate_cap, up_cap)` the next GEMV's activations (fp16 pair
+    layout `[plan.rows, N // 2]`). Unrouted rows are left uninitialized."""
+    num_experts, n, k_half = weight.shape
+    k = 2 * k_half
+    assert act.dtype == torch.float16 and act.shape[1] == k and act.is_contiguous()
+    assert weight.dtype == torch.uint8 and weight.is_contiguous()
+    assert weight_scale.shape == (num_experts, n, k // 16)
+    assert k % 32 == 0 and plan.tile == 16 and plan.max_ctas <= DIRECT_MAX_CTAS
+    config = gemv_config(n, k)
+    g0 = config.g0
+    if g0 < 0:
+        g0 = 1 << ((k // 32).bit_length() - 1)
+    gammas, gate_cap, up_cap = situ if situ is not None else (amax, 0.0, 0.0)
+    if situ is not None:
+        assert config.bn % 2 == 0 and n % 16 == 0
+        out = torch.empty((plan.rows, n // 2), dtype=torch.float16, device=act.device)
+    else:
+        out = torch.empty((plan.rows, n), dtype=torch.bfloat16, device=act.device)
+    if plan.max_ctas > GEMV_MAX_CTAS:
+        rcfg = rows_config(n, k)
+        _nvfp4_gemv_f16_rows_kernel[(n // rcfg.bn, plan.max_ctas)](
+            act.view(torch.int64),
+            row_token if row_token is not None else tiles,
+            weight.view(torch.int32),
+            weight_scale.view(torch.uint8),
+            amax,
+            denominator,
+            out,
+            gammas,
+            tiles,
+            plan.max_ctas,
+            N=n,
+            K=k,
+            TILE=plan.tile,
+            BN=rcfg.bn,
+            G0=g0 if rcfg.bn == config.bn else 1 << ((k // 32).bit_length() - 1),
+            G1=config.g,
+            G=rcfg.g,
+            R=plan.tile,
+            BY_TOKEN=row_token is not None,
+            SITU=situ is not None,
+            GATE_CAP=gate_cap,
+            UP_CAP=up_cap,
+            num_warps=rcfg.num_warps,
+            enable_fp_fusion=False,
+        )
+        return out
+    _nvfp4_gemv_f16_kernel[(n // config.bn, plan.max_ctas)](
+        act.view(torch.int64),
+        row_token if row_token is not None else tiles,
+        weight.view(torch.int32),
+        weight_scale.view(torch.uint8),
+        amax,
+        denominator,
+        out,
+        gammas,
+        tiles,
+        plan.max_ctas,
+        N=n,
+        K=k,
+        TILE=plan.tile,
+        BN=config.bn,
+        G0=g0,
+        G=config.g,
+        BY_TOKEN=row_token is not None,
+        SITU=situ is not None,
+        GATE_CAP=gate_cap,
+        UP_CAP=up_cap,
+        num_warps=config.num_warps,
+        enable_fp_fusion=False,
+    )
+    return out
+
+
+def to_f16_pairs(x: torch.Tensor) -> torch.Tensor:
+    """fp16 copy of bf16 rows `x` in the `_f16_pair_slot` layout
+    (reference / tests; `moe.route` writes it in the routing kernel)."""
+    k = x.shape[-1]
+    assert k % 8 == 0
+    idx = torch.arange(k, device=x.device)
+    slot = (idx & ~7) | (idx & 4) | ((idx & 1) << 1) | ((idx >> 1) & 1)
+    out = torch.empty(x.shape, dtype=torch.float16, device=x.device)
+    out[..., slot] = x.to(torch.float16)
+    return out
+
+
+@dataclass(frozen=True)
+class Nvfp4GemvConfig:
+    """Decode launch config: BN columns per program; the K groups (32 wide)
+    unrolled as g0 first (one wide load; -1: the largest power of two of
+    them), then steps of g."""
+
+    bn: int
+    g0: int
+    g: int
+    num_warps: int
+
+
+# gfx12 decode configs by K, from a sweep on the R9700 (gfx1201) of Mini's
+# experts at 1 and 8 tokens (`.claude/r9700/scripts/b3_gemv_try.py`).
+_GFX12_GEMV_CONFIGS = {2304: (8, -1, 8, 2), 1152: (8, -1, 4, 1)}
+# The GEMV runs plans of at most this many tiles of 16 rows: up to 2 tokens
+# (top-8). Its cost grows with routed rows (each row of a tile re-decodes the
+# weights) while WMMA's grows with tiles, and real multi-token routing is
+# concentrated (DSpark verify of 8 tokens: 64 rows on ~29 experts, up to 8
+# rows a tile), so WMMA wins from 4 tokens on.
+GEMV_MAX_CTAS = 16
+# Direct (bf16-activation) plans up to this many tiles run `gemv_f16`; past
+# GEMV_MAX_CTAS on the multi-row kernel, which decodes each weight chunk once
+# per tile for all its rows. Measured on concentrated verify routing (one
+# layer, `.claude/r9700/scripts/verify_moe_bench.py --noise 0.8`), us vs the
+# MXFP8 + fp16 WMMA path: 3 tokens 175 vs 207, 4: 219 vs 248, 5: 255 vs 272,
+# 6: 295 vs 302, 8: 357 vs 336; so up to 6 tokens (48 tiles).
+DIRECT_MAX_CTAS = int(os.environ.get("VLLM_INKLING2_DIRECT_MAX_CTAS", "48"))
+# Multi-row kernel configs by K: (BN, G, num_warps), same sweep.
+_GFX12_ROWS_CONFIGS = {2304: (8, 8, 2), 1152: (8, 8, 2)}
+
+
+@functools.cache
+def rows_config(n: int, k: int) -> Nvfp4GemvConfig:
+    env = os.environ.get(f"VLLM_INKLING2_ROWS_CONFIG_{k}")
+    bn, g, num_warps = (
+        tuple(int(v) for v in env.split(","))
+        if env
+        else _GFX12_ROWS_CONFIGS.get(k, (8, 16, 2))
+    )
+    while n % bn:
+        bn //= 2
+    return Nvfp4GemvConfig(bn, -1, g, num_warps)
+
+
+@functools.cache
+def gemv_config(n: int, k: int) -> Nvfp4GemvConfig:
+    bn, g0, g, num_warps = _GFX12_GEMV_CONFIGS.get(k, (8, -1, 8, 2))
+    while n % bn:
+        bn //= 2
+    return Nvfp4GemvConfig(bn, g0, g, num_warps)
+
+
+def gemv(
+    act: torch.Tensor,
+    act_scale: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    amax: torch.Tensor,
+    denominator: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+    config: Nvfp4GemvConfig | None = None,
+) -> torch.Tensor:
+    """`bmm` for decode: the same contract and result up to the order of the
+    fp32 additions, faster for a few routed rows per expert."""
+    num_experts, n, k_half = weight.shape
+    k = 2 * k_half
+    assert act.shape == (plan.rows, k) and act.dtype == torch.float8_e4m3fn
+    assert weight.dtype == torch.uint8
+    assert weight_scale.shape == (num_experts, n, k // 16)
+    assert weight_scale.dtype == torch.float8_e4m3fn
+    assert weight.is_contiguous() and weight_scale.is_contiguous()
+    assert k % 32 == 0
+    if config is None:
+        config = gemv_config(n, k)
+    g0 = config.g0
+    if g0 < 0:
+        g0 = 1 << ((k // 32).bit_length() - 1)
+    assert n % config.bn == 0 and 0 < g0 <= k // 32, (config, n, k)
+    out = torch.empty((plan.rows, n), dtype=torch.bfloat16, device=act.device)
+    _nvfp4_gemv_kernel[(n // config.bn, plan.max_ctas)](
+        act.view(torch.int64),
+        act_scale,
+        weight.view(torch.int32),
+        weight_scale.view(torch.uint8),
+        amax,
+        denominator,
+        out,
+        tiles,
+        plan.max_ctas,
+        N=n,
+        K=k,
+        TILE=plan.tile,
+        BN=config.bn,
+        G0=g0,
+        G=config.g,
+        num_warps=config.num_warps,
+    )
+    return out
+
+
+@dataclass(frozen=True)
+class Nvfp4BmmConfig:
+    """Launch config: a BM x BN output block per program (BM divides the
+    token tile or covers it), BK-deep K steps (a multiple of 32)."""
+
+    bm: int
+    bn: int
+    bk: int
+    num_warps: int
+    num_stages: int
+
+
+# gfx12 by token tile: (BM, BN, BK, num_warps, num_stages), from a sweep on
+# the R9700 (gfx1201) of Inkling-2-Mini's NVFP4 experts (128 experts, top-8,
+# [2304, 2304] and [2304, 1152]) at 64, 512 and 2048 tokens
+# (`.claude/b1/scripts/bench_nvfp4_bmm.py --sweep`).
+_GFX12_CONFIGS = {
+    16: (16, 64, 128, 4, 3),
+    32: (32, 128, 64, 8, 3),
+    64: (64, 128, 64, 8, 3),
+    128: (64, 256, 64, 4, 2),
+    256: (64, 256, 64, 4, 2),
+}
+
+
+@functools.cache
+def bmm_config(tile: int, n: int, k: int) -> Nvfp4BmmConfig:
+    """Launch config for token tiles of `tile` rows and `[N, K]` experts."""
+    bm, bn, bk, num_warps, num_stages = _GFX12_CONFIGS[min(max(tile, 16), 256)]
+    while n % bn:
+        bn //= 2
+    while k % bk:
+        bk //= 2
+    assert bn >= 16 and bk >= 32, (n, k)
+    return Nvfp4BmmConfig(bm, bn, bk, num_warps, num_stages)
+
+
+def bmm(
+    act: torch.Tensor,
+    act_scale: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    amax: torch.Tensor,
+    denominator: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+    config: Nvfp4BmmConfig | None = None,
+) -> torch.Tensor:
+    """bf16 `[plan.rows, N]` expert GEMM of the tile-padded MXFP8 `act` rows
+    (block scales swizzled for `plan.tile`) with NVFP4 expert weights, by
+    each tile's expert (`tiles`: the `moe.route` metadata). Rows past each
+    tile's routed rows are left uninitialized. Decode plans (16-row tiles,
+    at most `GEMV_MAX_CTAS`) run `gemv`; `config` overrides `bmm_config`
+    (tuning) and always runs the WMMA kernel."""
+    num_experts, n, k_half = weight.shape
+    k = 2 * k_half
+    assert act.shape == (plan.rows, k) and act.dtype == torch.float8_e4m3fn
+    assert weight.dtype == torch.uint8
+    assert weight_scale.shape == (num_experts, n, k // 16)
+    assert weight_scale.dtype == torch.float8_e4m3fn
+    assert amax.shape == (num_experts,) and denominator.shape == (1,)
+    assert weight.is_contiguous() and weight_scale.is_contiguous()
+    tile = plan.tile
+    if config is None and tile == 16 and plan.max_ctas <= GEMV_MAX_CTAS:
+        return gemv(
+            act, act_scale, weight, weight_scale, amax, denominator, tiles, plan
+        )
+    out = torch.empty((plan.rows, n), dtype=torch.bfloat16, device=act.device)
+    if config is None:
+        config = bmm_config(tile, n, k)
+    assert n % config.bn == 0 and k % config.bk == 0 and config.bk % 32 == 0
+    # The pack=2 decode needs two codes words per thread: BN x 8 words of a
+    # 32-wide group over num_warps * 32 threads (fewer give wrong results).
+    assert config.bn * 8 >= 64 * config.num_warps, config
+    bm = config.bm
+    assert bm >= tile or tile % bm == 0, (config, tile)
+    sub = tile // bm if tile >= bm else 1
+    _nvfp4_bmm_kernel[(n // config.bn, plan.max_ctas * sub)](
+        act.view(torch.int16),
+        act_scale,
+        weight.view(torch.int16),
+        weight_scale,
+        amax,
+        denominator,
+        out,
+        tiles,
+        plan.max_ctas,
+        N=n,
+        K=k,
+        TILE=tile,
+        BM=bm,
+        BN=config.bn,
+        BK=config.bk,
+        num_warps=config.num_warps,
+        num_stages=config.num_stages,
+        matrix_instr_nonkdim=16,
+    )
+    return out

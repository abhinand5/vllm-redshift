+class Inkling2LayerMoE(Inkling2MoE):
+    """`Inkling2MoE` with the NVIDIA layer's routed-experts capture: one
+    capture row per loop pass of the layer (`visit_ids`, from
+    `Inkling2ModelConfig.layer_visit_ids`), picked by `pass_idx`."""
+
+    def __init__(self, config, visit_ids: Sequence[int] = (0,), **kwargs) -> None:
+        super().__init__(config, **kwargs)
+        self.routing_captures = nn.ModuleList(
+            Inkling2RoutingCapture(visit) for visit in visit_ids
+        )
+
+    def routed_expert_ids(self, x: torch.Tensor) -> torch.Tensor:
+        """Each token's top-k expert ids `[T, topk]`: the routing kernel's
+        selection (`sigmoid(x @ gate.T) + bias`, fp32 K-group logits),
+        recomputed in torch. Only runs with routed-experts capture."""
+        gate = self.gate
+        logits = linear_k_groups(x, gate.weight)
+        return torch.topk(logits.sigmoid() + gate.bias, gate.topk).indices.int()
+
+    def forward(self, x: torch.Tensor, pass_idx: int = 0) -> torch.Tensor:
+        capture_fn = self.routing_captures[pass_idx].capture_fn
+        if capture_fn is not None:
+            capture_fn(self.routed_expert_ids(x.contiguous()))
+        return super().forward(x)
+

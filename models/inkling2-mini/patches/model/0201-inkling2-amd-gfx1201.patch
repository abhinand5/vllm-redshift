+def segment_gemv_rows(
+    pairs: list[tuple[torch.Tensor, torch.Tensor]],
+) -> list[torch.Tensor] | None:
+    """`[gemv_rows(x, w) for x, w in pairs]` for spec-decode verify windows
+    (2..16 rows) in one launch, every segment on `gemv_rows`' matrix-core
+    tile (bit for bit equal to it for its wide projections; narrow ones,
+    such as the convs' dynamic taps, round like a matrix-core GEMV). bf16
+    `(M, K)` inputs (rows may be strided) and `(N, K)` weights, same M and K.
+    Returns None when that does not apply."""
+    from .linear import GEMV_ROWS_MAX, _gemv_rows_config

+        *args,
+        m,
+        K=k,
+        BM=bm,
+        BN=bn,
+        BK=bk,
+        NUM_SEG=len(pairs),
+        END0=ends[0],
+        END1=ends[1],
+        END2=ends[2],
+        END3=ends[3],
+        num_warps=num_warps,
+    )
+    return outs

@@ -0,0 +1,224 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Loop message controllers, batched over streams.
+
+A controller blends a fp32 message into a fp32 sublayer input `dest`: from
+`h = down(rms([dest, message]))` (bf16), `out = (1 - tanh(forget(h))) * dest +
+tanh(gain(h)) * message` in fp32, unfused as the reference. The output feeds
+the sublayer's RMSNorm, applied in the same kernel.
+
+AMD copy of `nvidia/ops/loop.py`: `tl.rsqrt` instead of the NVIDIA inline-PTX
+`rsqrt.approx` (which compiles on ROCm but returns garbage), and the warp count
+of `ops.norm.rms_norm`, whose reduction order the weightless norms keep.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, tldevice, triton
+
+
+def _num_warps(block: int) -> int:
+    # As `ops.norm.rms_norm`: the same reduction tree, so the same rounding.
+    return min(max(block // 512, 1), 16)
+
+
+@triton.jit
+def _pair_rms_norm_kernel(
+    Dest,
+    Message,
+    Out,
+    stride_dest_s,
+    T,
+    eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    s = tl.program_id(0).to(tl.int64)
+    t = tl.program_id(1).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    dest = tl.load(Dest + s * stride_dest_s + t * D + cols, mask, other=0)
+    message = tl.load(Message + (s * T + t) * D + cols, mask, other=0)
+    dest_rstd = tl.rsqrt(tl.div_rn(tl.sum(dest * dest), D) + eps)
+    message_rstd = tl.rsqrt(tl.div_rn(tl.sum(message * message), D) + eps)
+    out = Out + (s * T + t) * (2 * D)
+    tl.store(out + cols, (dest * dest_rstd).to(Out.dtype.element_ty), mask)
+    tl.store(out + D + cols, (message * message_rstd).to(Out.dtype.element_ty), mask)
+
+
+def pair_rms_norm(dest: torch.Tensor, message: torch.Tensor) -> torch.Tensor:
+    """bf16 `(S, T, 2D)` `[rms(dest), rms(message)]` of fp32 `(S, T, D)`
+    inputs, weightless; `dest` may broadcast over streams (stride 0)."""
+    num_streams, num_tokens, d = message.shape
+    assert dest.shape == message.shape and message.is_contiguous()
+    assert dest.stride(1) == d and dest.stride(2) == 1
+    assert dest.dtype == message.dtype == torch.float32
+    out = message.new_empty((num_streams, num_tokens, 2 * d), dtype=torch.bfloat16)
+    if num_tokens:
+        block = triton.next_power_of_2(d)
+        _pair_rms_norm_kernel[(num_streams, num_tokens)](
+            dest,
+            message,
+            out,
+            dest.stride(0),
+            num_tokens,
+            1e-6,
+            D=d,
+            BLOCK=block,
+            num_warps=_num_warps(block),
+        )
+    return out
+
+
+@triton.jit
+def _blend_rms_norm_kernel(
+    Dest,
+    Message,
+    GainForget,
+    NormW,
+    Out,
+    stride_dest_s,
+    stride_w_s,
+    T,
+    norm_eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    s = tl.program_id(0).to(tl.int64)
+    t = tl.program_id(1).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    row = s * T + t
+    dest = tl.load(Dest + s * stride_dest_s + t * D + cols, mask, other=0)
+    message = tl.load(Message + row * D + cols, mask, other=0)
+    gain = tldevice.tanh(tl.load(GainForget + row * (2 * D) + cols, mask, other=0))
+    forget = tldevice.tanh(
+        tl.load(GainForget + row * (2 * D) + D + cols, mask, other=0)
+    )
+    x = (1.0 - forget) * dest + gain * message
+    rstd = tl.rsqrt(tl.div_rn(tl.sum(x * x), D) + norm_eps)
+    y = x * rstd
+    y = y * tl.load(NormW + s * stride_w_s + cols, mask, other=0).to(tl.float32)
+    tl.store(Out + row * D + cols, y.to(Out.dtype.element_ty), mask)
+
+
+def blend_rms_norm(
+    dest: torch.Tensor,
+    message: torch.Tensor,
+    gain_forget: torch.Tensor,
+    norm_weight: torch.Tensor,
+    norm_eps: float,
+) -> torch.Tensor:
+    """bf16 `(S, T, D)` RMSNorm (row `s` of `norm_weight` `(S, D)`) of
+    `(1 - tanh(forget)) * dest + tanh(gain) * message`, with fp32 `(S, T, D)`
+    `dest` (may broadcast over streams) and `message`, and fp32 `(S, T, 2D)`
+    `gain_forget` = `[gain, forget]`. `norm_weight` may broadcast too."""
+    num_streams, num_tokens, d = message.shape
+    assert dest.shape == message.shape and message.is_contiguous()
+    assert dest.stride(1) == d and dest.stride(2) == 1
+    assert gain_forget.shape == (num_streams, num_tokens, 2 * d)
+    assert gain_forget.is_contiguous() and gain_forget.dtype == torch.float32
+    assert norm_weight.shape == (num_streams, d) and norm_weight.stride(1) == 1
+    out = message.new_empty((num_streams, num_tokens, d), dtype=torch.bfloat16)
+    if num_tokens:
+        block = triton.next_power_of_2(d)
+        _blend_rms_norm_kernel[(num_streams, num_tokens)](
+            dest,
+            message,
+            gain_forget,
+            norm_weight,
+            out,
+            dest.stride(0),
+            norm_weight.stride(0),
+            num_tokens,
+            norm_eps,
+            D=d,
+            BLOCK=block,
+            num_warps=_num_warps(block),
+            # The blend is unfused (no FMA), as the reference.
+            enable_fp_fusion=False,
+        )
+    return out
+
+
+@triton.jit
+def _pair_norm_gemv_kernel(
+    Dest,
+    Message,
+    W,
+    Y,
+    stride_dest_s,
+    stride_ws,
+    stride_wn,
+    N,
+    eps,
+    D: tl.constexpr,
+    BLOCK: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+):
+    # `_pair_rms_norm_kernel` of one stream's row (each program recomputes
+    # the two RMS), feeding `ops.linear._gemv_kernel`'s tile of BN rows.
+    s = tl.program_id(1).to(tl.int64)
+    dest_row = Dest + s * stride_dest_s
+    message_row = Message + s * D
+    cols = tl.arange(0, BLOCK)
+    mask = cols < D
+    dest = tl.load(dest_row + cols, mask, other=0)
+    message = tl.load(message_row + cols, mask, other=0)
+    dest_rstd = tl.rsqrt(tl.div_rn(tl.sum(dest * dest), D) + eps)
+    message_rstd = tl.rsqrt(tl.div_rn(tl.sum(message * message), D) + eps)
+
+    K: tl.constexpr = 2 * D
+    rows = tl.program_id(0) * BN + tl.arange(0, BN)
+    w_rows = W + s * stride_ws + rows[:, None].to(tl.int64) * stride_wn
+    acc = tl.zeros((BN, BK), tl.float32)
+    for k0 in tl.static_range(0, K, BK):
+        ks = k0 + tl.arange(0, BK)
+        is_dest = ks < D
+        xd = tl.load(dest_row + ks, is_dest, other=0) * dest_rstd
+        xm = tl.load(message_row + ks - D, (ks >= D) & (ks < K), other=0)
+        x = tl.where(is_dest, xd, xm * message_rstd).to(tl.bfloat16)
+        w = tl.load(
+            w_rows + ks[None, :], (rows[:, None] < N) & (ks[None, :] < K), other=0
+        )
+        acc += w.to(tl.float32) * x.to(tl.float32)[None, :]
+    y = tl.sum(acc, 1).to(Y.dtype.element_ty)
+    tl.store(Y + s * N + rows, y, rows < N)
+
+
+def pair_norm_gemv(
+    dest: torch.Tensor, message: torch.Tensor, weight: torch.Tensor
+) -> torch.Tensor:
+    """`gemv(pair_rms_norm(dest, message), weight)` for one token: fp32
+    `(S, 1, D)` `dest` (may broadcast over streams) and `message`, bf16
+    `(S, N, 2D)` `weight`; returns bf16 `(S, 1, N)`, the same bits as the
+    two launches."""
+    from .linear import _gemv_config
+
+    num_streams, num_tokens, d = message.shape
+    assert num_tokens == 1 and dest.shape == message.shape
+    assert message.is_contiguous() and dest.stride(2) == 1
+    assert dest.dtype == message.dtype == torch.float32
+    n = weight.shape[1]
+    assert weight.shape == (num_streams, n, 2 * d) and weight.stride(2) == 1
+    assert weight.dtype == torch.bfloat16
+    bn, bk, num_warps = _gemv_config(num_streams, n, 2 * d)
+    out = message.new_empty((num_streams, 1, n), dtype=torch.bfloat16)
+    _pair_norm_gemv_kernel[(triton.cdiv(n, bn), num_streams)](
+        dest,
+        message,
+        weight,
+        out,
+        dest.stride(0),
+        weight.stride(0),
+        weight.stride(1),
+        n,
+        1e-6,
+        D=d,
+        BLOCK=triton.next_power_of_2(d),
+        BN=bn,
+        BK=bk,
+        num_warps=num_warps,
+    )
+    return out

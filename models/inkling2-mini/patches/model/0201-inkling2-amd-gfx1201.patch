+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Several one-row GEMVs with their own inputs and weights in one launch.
+
+Batch-1 decode projects a full (or looped) layer's query side, K and V and
+the K/V convs' dynamic taps from up to three inputs: five small GEMVs whose
+launch gaps cost about as much as their weight reads. `segment_gemv` runs
+them as one grid, each program one `ops.linear.gemv` tile of one segment
+with that GEMV's own tile shape, so every output equals its `gemv` bit for
+bit.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+from .linear import _gemv_config
+
+MAX_SEGMENTS = 5
+
+
+@triton.jit
+def _gemv_tile(
+    X, W, Y, N, stride_wn, pid, K: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr
+):
+    # `ops.linear._gemv_kernel` for one stream.
+    rows = pid * BN + tl.arange(0, BN)
+    w_rows = W + rows[:, None].to(tl.int64) * stride_wn
+    acc = tl.zeros((BN, BK), tl.float32)
+    for k0 in tl.static_range(0, K, BK):
+        ks = k0 + tl.arange(0, BK)
+        x = tl.load(X + ks, ks < K, other=0)
+        w = tl.load(
+            w_rows + ks[None, :], (rows[:, None] < N) & (ks[None, :] < K), other=0
+        )
+        acc += w.to(tl.float32) * x.to(tl.float32)[None, :]
+    tl.store(Y + rows, tl.sum(acc, 1).to(Y.dtype.element_ty), rows < N)
+
+
+@triton.jit
+def _segment_gemv_kernel(
+    X0, W0, Y0, N0, S0,
+    X1, W1, Y1, N1, S1,
+    X2, W2, Y2, N2, S2,
+    X3, W3, Y3, N3, S3,
+    X4, W4, Y4, N4, S4,
+    K: tl.constexpr,
+    BK: tl.constexpr,
+    NUM_SEG: tl.constexpr,
+    BN0: tl.constexpr, BN1: tl.constexpr, BN2: tl.constexpr,
+    BN3: tl.constexpr, BN4: tl.constexpr,
+    END0: tl.constexpr, END1: tl.constexpr, END2: tl.constexpr,
+    END3: tl.constexpr,
+):  # fmt: skip
+    # Programs [END_{i-1}, END_i) are segment i's tiles.
+    pid = tl.program_id(0)
+    if pid < END0:
+        _gemv_tile(X0, W0, Y0, N0, S0, pid, K, BN0, BK)
+    elif NUM_SEG > 1 and pid < END1:
+        _gemv_tile(X1, W1, Y1, N1, S1, pid - END0, K, BN1, BK)
+    elif NUM_SEG > 2 and pid < END2:
+        _gemv_tile(X2, W2, Y2, N2, S2, pid - END1, K, BN2, BK)
+    elif NUM_SEG > 3 and pid < END3:
+        _gemv_tile(X3, W3, Y3, N3, S3, pid - END2, K, BN3, BK)
+    elif NUM_SEG > 4:
+        _gemv_tile(X4, W4, Y4, N4, S4, pid - END3, K, BN4, BK)
+
+
+def segment_gemv(
+    pairs: list[tuple[torch.Tensor, torch.Tensor]],
+) -> list[torch.Tensor] | None:
+    """`[gemv(x, w) for x, w in pairs]` in one launch: bf16 `(1, K)` inputs
+    and `(N, K)` weights (rows contiguous along K) with the same K.
+
+    Returns None (the caller runs the GEMVs one by one) when the GEMVs'
+    configs need different `BK` or warp counts.
+    """
+    assert 0 < len(pairs) <= MAX_SEGMENTS
+    k = pairs[0][1].shape[1]
+    configs = []
+    for x, w in pairs:
+        assert x.shape == (1, k) and w.shape[1] == k
+        assert x.dtype == w.dtype == torch.bfloat16
+        assert x.stride(-1) == 1 and w.stride(-1) == 1
+        configs.append(_gemv_config(1, w.shape[0], k))
+    if len({(bk, warps) for _, bk, warps in configs}) != 1:
+        return None
+    bk, num_warps = configs[0][1:]
+    outs = [x.new_empty((1, w.shape[0])) for x, w in pairs]
+    args: list = []
+    bns, ends = [], []
+    end = 0
+    for (x, w), y, (bn, _, _) in zip(pairs, outs, configs):
+        args += [x, w, y, w.shape[0], w.stride(0)]
+        bns.append(bn)
+        end += triton.cdiv(w.shape[0], bn)
+        ends.append(end)
+    for _ in range(MAX_SEGMENTS - len(pairs)):
+        # Unused segments: never read.
+        args += [*args[:2], args[2], 0, 0]
+        bns.append(1)
+        ends.append(end)
+    _segment_gemv_kernel[(end,)](
+        *args,
+        K=k,
+        BK=bk,
+        NUM_SEG=len(pairs),
+        BN0=bns[0],
+        BN1=bns[1],
+        BN2=bns[2],
+        BN3=bns[3],
+        BN4=bns[4],
+        END0=ends[0],
+        END1=ends[1],

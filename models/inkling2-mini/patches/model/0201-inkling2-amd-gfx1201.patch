+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""PLACEHOLDER NVFP4 expert GEMM in plain torch: slow, exact, not graph-safe.
+
+Stands in for a gfx12 NVFP4 kernel behind the same interface as
+`triton_bmm.bmm` (plus the NVFP4 outer scales), so the NVFP4 expert layers of
+Inkling-2-Mini (0-19) run end to end before that kernel exists. It reads the
+host copy of the routing `tiles` (one device sync per call) and dequantizes
+each routed expert's weights to fp32, so it cannot be captured in a HIP graph;
+run models using it eagerly.
+
+Weights are the checkpoint's tensors as stored (no row shuffle, no scale
+swizzle): `weight` uint8 [E, N, K / 2] holds two e2m1 codes per byte (low
+nibble = even k; bit 3 = sign, bits 0-2 index 0, .5, 1, 1.5, 2, 3, 4, 6),
+`weight_scale` e4m3 [E, N, K / 16], `amax` fp32 [E], `denominator` fp32 [1]:
+
+    w[e, n, k] = e2m1(weight) * weight_scale[e, n, k // 16] * amax[e] / denominator
+
+with `amax[e] / denominator` applied to the GEMM output per row, as NVIDIA's
+GEMMs do. Activations are the MXFP8 rows of `ops.moe.route` /
+`ops.activation.swiglu_quantize`.
+"""
+
+import torch
+
+from .triton_bmm import ExpertPlan
+
+_E2M1 = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+_E2M1 = _E2M1 + tuple(-v for v in _E2M1)
+
+
+def dequant_nvfp4(values: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    """fp32 `[..., N, K]` of NVFP4 `values` uint8 `[..., N, K / 2]` and their
+    e4m3 block scales `[..., N, K / 16]`, without the outer scale. Exact:
+    every product of an e2m1 value and an e4m3 scale is an fp32."""
+    assert values.dtype == torch.uint8 and scales.dtype == torch.float8_e4m3fn
+    assert scales.shape[-1] * 8 == values.shape[-1]
+    lut = torch.tensor(_E2M1, dtype=torch.float32, device=values.device)
+    codes = torch.stack((values & 0xF, values >> 4), -1).flatten(-2)
+    return lut[codes.long()] * scales.float().repeat_interleave(16, -1)
+
+
+def _scale_offsets(rows: torch.Tensor, cols: int, tile: int) -> torch.Tensor:
+    """Offsets of the block scales of `rows` in the `mxfp8._scale_offsets`
+    layout of `cols`-column scales for `tile`-row token tiles."""
+    r = rows[:, None]
+    c = torch.arange(cols, device=rows.device)[None, :]
+    if tile >= 128:
+        blocks = (r // 128) * (cols // 4) + c // 4
+        return blocks * 512 + (r % 32) * 16 + (r // 32 % 4) * 4 + c % 4
+    return ((r // 8) * (cols // 4) + c // 4) * 32 + (r % 8) * 4 + c % 4
+
+
+def _dequant_act(
+    act: torch.Tensor, act_scale: torch.Tensor, rows: torch.Tensor, tile: int
+) -> torch.Tensor:
+    k = act.shape[1]
+    scales = act_scale.view(torch.uint8).flatten()[_scale_offsets(rows, k // 32, tile)]
+    exp2 = torch.exp2(scales.float() - 127).repeat_interleave(32, -1)
+    return act[rows].float() * exp2
+
+
+def nvfp4_bmm_reference(
+    act: torch.Tensor,
+    act_scale: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    amax: torch.Tensor,
+    denominator: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+) -> torch.Tensor:
+    """bf16 `[plan.rows, N]` expert GEMM of the tile-padded MXFP8 `act` rows
+    (block scales swizzled for `plan.tile`) with NVFP4 expert weights, by each
+    tile's expert (`tiles`: the `moe.route` metadata). Rows past each tile's
+    routed rows are 0."""
+    num_experts, n, k_half = weight.shape
+    k = 2 * k_half
+    assert act.shape == (plan.rows, k) and act.dtype == torch.float8_e4m3fn
+    assert weight.dtype == torch.uint8
+    assert weight_scale.shape == (num_experts, n, k // 16)
+    assert amax.shape == (num_experts,) and denominator.shape == (1,)
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError(
+            "nvfp4_bmm_reference is an eager-only placeholder (it syncs on the "
+            "routing tiles); run NVFP4 Inkling2 experts with enforce_eager"
+        )
+    out = torch.zeros((plan.rows, n), dtype=torch.bfloat16, device=act.device)
+    max_ctas, tile = plan.max_ctas, plan.tile
+    host = tiles.tolist()
+    num_tiles = host[2 * max_ctas]
+    rows_by_expert: dict[int, list[torch.Tensor]] = {}
+    for t in range(num_tiles):
+        start, end = t * tile, host[max_ctas + t]
+        if end > start:
+            rows_by_expert.setdefault(host[t], []).append(
+                torch.arange(start, end, device=act.device)
+            )
+    outer = (amax.float() / denominator.float()).tolist()
+    for expert, parts in rows_by_expert.items():
+        rows = torch.cat(parts)
+        a = _dequant_act(act, act_scale, rows, tile)
+        w = dequant_nvfp4(weight[expert], weight_scale[expert])
+        out[rows] = ((a @ w.T) * outer[expert]).to(torch.bfloat16)
+    return out

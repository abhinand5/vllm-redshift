+    assert 0 < len(pairs) <= MAX_SEGMENTS
+    m, k = pairs[0][0].shape
+    if not 2 <= m <= GEMV_ROWS_MAX:
+        return None
+    for x, w in pairs:
+        if (
+            x.dim() != 2
+            or x.shape != (m, k)
+            or w.shape[1] != k
+            or x.dtype != torch.bfloat16
+            or w.dtype != torch.bfloat16
+            or x.stride(-1) != 1
+            or w.stride(-1) != 1
+        ):
+            return None
+    bm, bn, bk, mode, num_warps = _gemv_rows_config(1, m, pairs[0][1].shape[0], k)
+    if mode != 0:
+        return None
+    outs = [x.new_empty((m, w.shape[0])) for x, w in pairs]
+    args: list = []
+    ends = []
+    end = 0
+    for (x, w), y in zip(pairs, outs):
+        args += [x, w, y, w.shape[0], x.stride(0), w.stride(0), y.stride(0)]

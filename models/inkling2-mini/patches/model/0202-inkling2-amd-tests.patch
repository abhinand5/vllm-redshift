+def _config(groups: list[dict], mtp: list[dict] | None = None) -> dict:
+    config: dict = {"quant_method": "inkling2", "model": {"parameter_groups": groups}}
+    if mtp is not None:
+        config["mtp"] = {"parameter_groups": mtp}
+    return config

+def test_nvfp4_gemv_matches_fp64(k: int, tiny: bool):
+    """Decode GEMV at Mini's K (a partial last unrolled step at 1152), one to
+    a few rows per expert. `tiny`: e4m3 subnormal block scales (decoded

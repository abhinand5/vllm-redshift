+@pytest.mark.skipif(not _is_rocm, reason="ROCm one-row GEMV")
+@pytest.mark.parametrize(
+    "streams, n, k, out_dtype",
+    [
+        (0, 8600, 2304, None),  # qkvr
+        (0, 2304, 3072, None),  # wo_ud
+        (0, 1024, 2304, None),  # k / v rows of qkvr
+        (0, 32, 2304, None),  # dynamic conv taps
+        (0, 131, 130, None),  # tails in N and K
+        (3, 64, 4608, None),  # loop controller down
+        (3, 4608, 64, torch.float32),  # loop controller gain / forget
+    ],
+)
+def test_rocm_gemv_matches_fp64_and_graph(streams, n, k, out_dtype):
+    """One-row decode GEMV: fp32-accumulated `x @ w.T` within output rounding
+    of fp64, on row-strided weight slices, and stable under graph replay."""
+    from vllm.models.inkling2.amd.ops.linear import decode_linear, gemv
+
+    torch.manual_seed(0)
+    s = max(streams, 1)
+    # Rows of a wider tensor (the projections slice qkvr's rows and stacks).
+    weight = (torch.randn(s, n + 5, k, device=DEVICE) * k**-0.5).bfloat16()[
+        :, 2 : n + 2
+    ]
+    x = torch.randn(s, 1, k + 8, device=DEVICE).bfloat16()[..., :k]
+    args = (x, weight) if streams else (x[0], weight[0])
+
+    def run():
+        if streams or out_dtype is not None:
+            return gemv(*args, out_dtype)
+        return decode_linear(*args)
+
+    def check(out):
+        ref = torch.einsum("snk,sk->sn", weight.double(), x[:, 0].double())
+        ref = ref if streams else ref[0]
+        out = out[:, 0] if streams else out[0]
+        dtype = out_dtype or torch.bfloat16
+        assert out.dtype == dtype
+        rounding = (ref.to(dtype).double() - ref).abs()
+        assert ((out.double() - ref).abs() <= 1e-4 + rounding).all()
+
+    check(run())
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = run()
+    for _ in range(2):
+        x.copy_(torch.randn_like(x))
+        graph.replay()
+        check(out)
+
+

+# --- NVFP4 placeholder GEMM -------------------------------------------------
+
+
+def _random_nvfp4(*shape: int, device="cuda") -> tuple[torch.Tensor, torch.Tensor]:
+    values = torch.randint(0, 256, (*shape[:-1], shape[-1] // 2), device=device)
+    scales = torch.rand(*shape[:-1], shape[-1] // 16, device=device) + 0.5
+    return values.to(torch.uint8), scales.to(torch.float8_e4m3fn)
+
+
+def _random_mxfp8(*shape: int, std: float = 1.0) -> tuple[torch.Tensor, torch.Tensor]:
+    values = (torch.randn(shape, device="cuda") * std).to(torch.float8_e4m3fn)
+    scales = torch.randint(120, 128, (*shape[:-1], shape[-1] // 32), device="cuda")
+    return values, scales.to(torch.uint8)
+
+
+def _dequant_mxfp8(values: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    return values.double() * torch.exp2(scales.double() - 127).repeat_interleave(32, -1)
+
+
+def _oracle_nvfp4(values, scales, amax, denominator) -> torch.Tensor:
+    """float64 bit-level decode (FACTS §4 (a), (c)), independent of the LUT."""
+    codes = torch.stack((values & 0xF, values >> 4), -1).flatten(-2).long()
+    sign = 1.0 - 2.0 * (codes >> 3).double()
+    exp, man = (codes >> 1) & 3, (codes & 1).double()
+    mag = torch.where(exp == 0, 0.5 * man, torch.exp2(exp.double() - 1) * (1 + man / 2))
+    block = scales.double().repeat_interleave(16, -1)
+    return sign * mag * block * (amax.double() / denominator.double())[..., None, None]
+
+
+def test_dequant_nvfp4_is_exact():
+    torch.manual_seed(0)
+    values, scales = _random_nvfp4(3, 64, 256)
+    amax = torch.rand(3, device="cuda") + 0.1
+    denominator = torch.tensor([2688.0], device="cuda")
+    # The block decode is exact in fp32; the outer scale is fp32 like NVIDIA's.
+    one = torch.ones(1, device="cuda")
+    raw = dequant_nvfp4(values, scales)
+    assert torch.equal(raw.double(), _oracle_nvfp4(values, scales, one.expand(3), one))
+    outer = (amax / denominator).double()
+    ref = _oracle_nvfp4(values, scales, outer.float(), one)
+    out = raw.double() * outer[:, None, None]
+    assert torch.equal(out, ref)
+    codes = torch.arange(16, dtype=torch.uint8, device="cuda")
+    one = torch.ones(1, 1, dtype=torch.float8_e4m3fn, device="cuda").expand(16, 1)
+    low = dequant_nvfp4((codes | 0x00)[:, None].expand(16, 8).contiguous(), one)
+    assert low[:, 0].tolist() == E2M1 and low[:, 1].tolist() == [0.0] * 16
+
+
+def _tiles(counts: list[int], tile: int, plan) -> tuple[torch.Tensor, list]:
+    experts, limits, rows, start = [], [], [], 0
+    for expert, count in enumerate(counts):
+        for t in range(-(-count // tile)):
+            experts.append(expert)
+            limits.append(min(start + (t + 1) * tile, start + count))
+        rows += [(start + i, expert) for i in range(count)]
+        start += -(-count // tile) * tile
+    pad = [0] * (plan.max_ctas - len(experts))
+    tiles = torch.tensor(
+        experts + pad + limits + pad + [len(experts), start],
+        dtype=torch.int32,
+        device="cuda",
+    )
+    return tiles, rows
+
+
+def _r8c4(scales: torch.Tensor) -> torch.Tensor:
+    rows, cols = scales.shape
+    tiles = scales.reshape(rows // 8, 8, cols // 4, 4).permute(0, 2, 1, 3)
+    return tiles.reshape(scales.shape).contiguous()
+
+
+@pytest.mark.parametrize("tile", [16, 128, 256])
+def test_nvfp4_bmm_reference_matches_fp64(tile: int):
+    """Placeholder GEMM over tile-padded expert segments (one empty expert,
+    one spanning tiles) equals an fp64 matmul of the dequantized operands
+    with the outer scale, rounded to bf16; padding rows stay 0."""
+    torch.manual_seed(0)
+    counts, n, k = [3, 0, 17, 1], 256, 1024
+    plan = triton_bmm.expert_plan(sum(counts), 1, len(counts), tile)
+    weight, weight_scale = _random_nvfp4(len(counts), n, k)
+    amax = torch.rand(len(counts), device="cuda") * 100 + 100
+    denominator = torch.tensor([2688.0], device="cuda")
+    act, act_scale = _random_mxfp8(plan.rows, k)
+    tiles, rows = _tiles(counts, tile, plan)
+    swizzle = swizzle_block_scales if tile >= 128 else _r8c4
+    out = nvfp4_bmm_reference(
+        act, swizzle(act_scale), weight, weight_scale, amax, denominator, tiles, plan
+    )
+    index = torch.tensor([r for r, _ in rows], device="cuda")
+    expert = torch.tensor([e for _, e in rows], device="cuda")
+    a = _dequant_mxfp8(act, act_scale)[index]
+    w = _oracle_nvfp4(weight, weight_scale, amax, denominator)[expert]
+    ref = torch.einsum("rk,rnk->rn", a, w).bfloat16().float()
+    torch.testing.assert_close(
+        out[index].float(), ref, atol=1e-3 * ref.abs().max().item(), rtol=1e-2
+    )
+    padding = torch.ones(plan.rows, dtype=torch.bool, device="cuda")
+    padding[index] = False
+    assert torch.all(out[padding] == 0)
+
+
+# --- NVFP4 GEMM (gfx12 kernel) ----------------------------------------------
+
+
+def _bmm_case(counts, n, k, tile, weight, weight_scale, amax, seed=0, act_std=1.0):
+    torch.manual_seed(seed)
+    plan = triton_bmm.expert_plan(sum(counts), 1, len(counts), tile)
+    act, act_scale = _random_mxfp8(plan.rows, k, std=act_std)
+    tiles, rows = _tiles(counts, tile, plan)
+    swizzle = swizzle_block_scales if tile >= 128 else _r8c4
+    denominator = torch.tensor([2688.0], device="cuda")
+    args = (act, swizzle(act_scale), weight, weight_scale, amax, denominator, tiles)
+    index = torch.tensor([r for r, _ in rows], device="cuda")
+    expert = torch.tensor([e for _, e in rows], device="cuda")
+    return plan, args, index, expert, _dequant_mxfp8(act, act_scale)
+
+
+def _run_kernel(kernel: str, args, plan) -> torch.Tensor:
+    """`bmm` as dispatched ("auto"), its WMMA kernel or the decode GEMV."""
+    if kernel == "gemv":
+        return nvfp4_moe.gemv(*args, plan)
+    if kernel == "wmma":
+        n, k_half = args[2].shape[1:]
+        config = nvfp4_moe.bmm_config(plan.tile, n, 2 * k_half)
+        return nvfp4_moe.bmm(*args, plan, config)
+    return nvfp4_moe.bmm(*args, plan)
+
+
+def _check_bmm(plan, args, index, expert, a64, label, kernel="auto"):
+    """Kernel vs. the placeholder GEMM and an fp64 oracle (both rounded to
+    bf16) on the routed rows; returns and prints the errors."""
+    out = _run_kernel(kernel, args, plan)[index].float()
+    ref = nvfp4_bmm_reference(*args, plan)[index].float()
+    act, _, weight, weight_scale, amax, denominator, _ = args
+    w = _oracle_nvfp4(weight, weight_scale, amax, denominator)
+    exact = torch.stack(
+        [a64[r] @ w[e].T for r, e in zip(index.tolist(), expert.tolist())]
+    )
+    oracle = exact.bfloat16().float()
+    top = exact.abs().max().item()
+    errors = {
+        "vs_ref_abs": (out - ref).abs().max().item(),
+        "vs_ref_rel": (out - ref).abs().max().item() / top,
+        "vs_fp64_abs": (out.double() - exact).abs().max().item(),
+        "vs_fp64_rel": (out.double() - exact).abs().max().item() / top,
+    }
+    print(label, {k: f"{v:.2e}" for k, v in errors.items()})
+    # fp32 accumulation, then one bf16 rounding: at most a bf16 ulp or two of
+    # the largest output away from the bf16-rounded fp64 result.
+    torch.testing.assert_close(out, oracle, atol=1e-2 * top, rtol=1e-2)
+    torch.testing.assert_close(out, ref, atol=1e-2 * top, rtol=1e-2)
+    assert errors["vs_fp64_rel"] < 1e-2
+    return errors
+
+
+@pytest.mark.parametrize("tile", [16, 32, 64, 128, 256])
+def test_nvfp4_bmm_matches_reference_and_fp64(tile: int):
+    """gfx12 NVFP4 GEMM over tile-padded expert segments (an empty expert,
+    one spanning tiles), both act scale layouts (R8c4 below 128-row tiles)."""
+    torch.manual_seed(0)
+    counts, n, k = [3, 0, 17, 1, 300], 256, 1024
+    weight, weight_scale = _random_nvfp4(len(counts), n, k)
+    amax = torch.rand(len(counts), device="cuda") * 100 + 100
+    case = _bmm_case(counts, n, k, tile, weight, weight_scale, amax)
+    _check_bmm(*case, f"tile={tile}", kernel="wmma")
+    if tile == 16:
+        _check_bmm(*case, f"tile={tile} gemv", kernel="gemv")
+

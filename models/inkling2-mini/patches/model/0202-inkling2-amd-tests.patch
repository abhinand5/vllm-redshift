+def _ref_rms(x: torch.Tensor, weight: torch.Tensor | None, eps: float) -> torch.Tensor:
+    y = x.float() * torch.rsqrt(x.float().square().mean(-1, keepdim=True) + eps)
+    return y if weight is None else y * weight.float()
+
+
+def _ref_mix(blocks, queries, norm_weight=None, norm_eps=0.0, addend=None):
+    """Block AttnRes (normalized values) of `blocks` (the last plus
+    `addend`, in fp32) with `queries` (Q, D): bf16 RMSNorm-ed with
+    `norm_weight` (Q, D), or fp32 without."""
+    values = torch.stack([b.float() for b in blocks])
+    if addend is not None:
+        values[-1] += addend.float()
+    inv_rms = torch.rsqrt(values.square().mean(-1) + 1e-6)
+    probs = torch.einsum("ntd,qd,nt->qtn", values, queries, inv_rms).softmax(-1)
+    mix = torch.einsum("qtn,ntd->qtd", probs, values * inv_rms[..., None])
+    if norm_weight is None:
+        return mix
+    return _ref_rms(mix, norm_weight[:, None], norm_eps).bfloat16()
+
+
+def _ref_conv(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """Causal depthwise static conv `(x + sum_lag w * x[t - lag]) *
+    (W + 1)**-0.5` of one sequence `x` (T, C), `weight` (C, 1, W): bf16."""
+    width = weight.shape[-1]
+    taps = weight.squeeze(1).float()
+    padded = torch.cat([x.new_zeros(width - 1, x.shape[1]), x]).float()
+    acc = torch.zeros_like(x, dtype=torch.float32)
+    for lag in reversed(range(width)):
+        acc += padded[width - 1 - lag : width - 1 - lag + len(x)] * taps[:, -1 - lag]
+    return ((acc + x.float()) * (width + 1) ** -0.5).bfloat16()
+
+
+def _ref_controller(layer, stream: int, dest, message, norm_weight, eps):
+    """A loop message controller on fp32 (T, D) inputs, then the RMSNorm."""
+    dim = dest.shape[-1]
+    down = layer.controller_down[stream].float()
+    gain = layer.controller_gain_forget[stream, :dim].float()
+    forget = layer.controller_gain_forget[stream, dim:].float()
+    pair = torch.cat((_ref_rms(dest, None, 1e-6), _ref_rms(message, None, 1e-6)), -1)
+    hidden = (pair.bfloat16().float() @ down.t()).bfloat16().float()
+    blended = (1 - torch.tanh(hidden @ forget.t())) * dest + torch.tanh(
+        hidden @ gain.t()
+    ) * message
+    return _ref_rms(blended, norm_weight, eps).bfloat16()
+
+
+def _kernel_mix(blocks, queries, norm_weight=None, norm_eps=0.0, addend=None):
+    """`_ref_mix` by the model's AttnRes kernel."""
+    from vllm.models.inkling2 import attn_res
+
+    last = blocks[-1]
+    stack = torch.stack(blocks[:-1]) if len(blocks) > 1 else last[None][:0]
+    return attn_res(stack, last, addend, queries, norm_weight, norm_eps, True)
+
+
+def _kernel_controller(layer, stream: int, dest, message, norm_weight, eps):
+    """`_ref_controller` by the model's controller kernels."""
+    one = slice(stream, stream + 1)
+    return layer.blend(one, dest[None], message[None], norm_weight[None], eps)[0]
+
+
+def _ref_loop_forward(
+    model, positions, embeds, mix=_ref_mix, controller=_ref_controller
+) -> torch.Tensor:
+    """A plain torch forward of `Inkling2LoopModel` (one prefill of one
+    sequence): visit order, pass restarts, the message bank, controllers,
+    AttnRes mixes, norms and the hidden-stream short convs. Attention and
+    MoE run the model's sublayers (their kernels have their own tests) with
+    each visit's loop pass."""
+    core = model.loop_core
+    queries = model.attn_res
+    visits = [(i, 0) for i in range(core.start)]
+    visits += [(i, p) for p in range(model.config.num_loop_passes) for i in core]
+    visits += [(i, 0) for i in range(core.stop, len(model.layers))]
+    tau = model._log_scaling_tau(positions)
+    completed: list[torch.Tensor] = []
+    partial = embeds
+    bank = prelude = None
+    for i, pass_idx in visits:
+        layer = model.layers[i]
+        if i == core.start and pass_idx == 0:
+            prelude = (list(completed), partial)
+        elif i == core.start:
+            assert prelude is not None
+            bank = [*completed, partial][len(prelude[0]) + 1 :]
+            assert len(bank) == 2
+            completed, partial = list(prelude[0]), prelude[1]
+        blocks = [*completed, partial]
+        norm = layer.attn_norm
+        messages = None
+        if pass_idx:
+            query = model.message_queries[i - core.start]
+            messages = mix(bank, query)
+            dests = mix(blocks, queries.attn_queries[i - 1])
+            dests = dests.expand(3, -1, -1) if layer.is_local else dests
+            weight = norm.weight.expand(3, -1) if layer.is_local else norm.weight
+            attn_inputs = [
+                controller(layer, s, dests[s], messages[s], weight[s], norm.eps)
+                for s in range(3)
+            ]
+        elif not completed:
+            attn_inputs = [
+                _ref_rms(partial, w, norm.eps).bfloat16() for w in norm.weight
+            ]
+        else:
+            attn_inputs = list(
+                mix(blocks, queries.attn_queries[i - 1], norm.weight, norm.eps)
+            )
+        attn = layer.attention(positions, attn_inputs, tau, pass_idx=pass_idx)
+        attn_out = _ref_conv(attn, layer.attn_sconv.weight)
+        first = i % model.block_size == 0
+        mlp_blocks, addend = (
+            ([*blocks, attn_out], None) if first else (blocks, attn_out)
+        )
+        norm = layer.mlp_norm
+        if messages is None:
+            mlp_in = mix(
+                mlp_blocks, queries.mlp_queries[i], norm.weight, norm.eps, addend
+            )
+        else:
+            mixed = mix(mlp_blocks, queries.mlp_queries[i], addend=addend)
+            mlp_in = controller(
+                layer, 3, mixed[0], messages[3], norm.weight[0], norm.eps
+            )[None]
+        mlp_out = _ref_conv(
+            layer.mlp(mlp_in[0], pass_idx=pass_idx), layer.mlp_sconv.weight
+        )
+        if first:
+            completed.append(partial)
+            partial = (attn_out.float() + mlp_out.float()).bfloat16()
+        else:
+            partial = (partial.float() + attn_out.float() + mlp_out.float()).bfloat16()
+    norm = model.norm
+    return mix([*completed, partial], queries.output_query, norm.weight, norm.eps)[0]
+
+
+def _compare_loop_reference(model: torch.nn.Module, kernel_ops: bool) -> None:
+    """Redraw the loop controllers, routers and AttnRes queries (dummy ones
+    leave every pass and mix alike), then record each forward's output with
+    the reference forward of the same inputs, run after it (AttnRes and
+    controllers by the model's kernels with `kernel_ops`; else in torch,
+    with the experts' down projections zeroed: their MXFP8 activation
+    quantization would amplify rounding-level differences). Per
+    forward, its token count, the output's max magnitude and the max over
+    tokens of the relative RMS error (plain floats: `apply_model` results
+    cross a process boundary)."""
+    generator = torch.Generator(device="cuda").manual_seed(0)
+    loop_model = model.model
+    for name, param in loop_model.named_parameters():
+        if "queries" in name or "query" in name:
+            std = 1.0 if "middle_cycle" in name else param.shape[-1] ** -0.5
+            param.data.normal_(std=std, generator=generator)
+    loop_model.process_weights_after_loading()
+    for layer in loop_model.layers:
+        # Fixed routing (a distinct bias per expert): rounding-level input
+        # differences must not flip a token's experts.
+        gate = layer.mlp.gate
+        gate.weight.zero_()
+        gate.bias.copy_(torch.linspace(1, 0, len(gate.bias)))
+        if not kernel_ops:
+            layer.mlp.experts.w2_weight.zero_()
+        if hasattr(layer, "controller_down"):
+            down, gain_forget = layer.controller_down, layer.controller_gain_forget
+            down.normal_(std=down.shape[-1] ** -0.5, generator=generator)
+            gain_forget.normal_(std=gain_forget.shape[-1] ** -0.5, generator=generator)
+    ops = (_kernel_mix, _kernel_controller) if kernel_ops else ()
+    results: list[tuple[float, ...]] = []
+    model.reference_results = results
+    forward = loop_model.forward
+
+    def compare(positions, inputs_embeds):
+        out = forward(positions, inputs_embeds)
+        with torch.no_grad():
+            ref = _ref_loop_forward(loop_model, positions, inputs_embeds, *ops)
+        diff = (out.float() - ref.float()).norm(dim=-1)
+        error = diff / ref.float().norm(dim=-1)
+        quantiles = error.quantile(error.new_tensor([0.5, 0.9])).tolist()
+        results.append(
+            (len(out), out.abs().amax().item(), error.max().item(), *quantiles)
+        )
+        return out
+
+    loop_model.forward = compare
+
+
+def _reference_results(model: torch.nn.Module):
+    return model.reference_results
+
+
+@pytest.mark.parametrize("kernel_ops", [True, False])
+def test_tiny_looped_model_matches_torch_reference(tmp_path, enable_pickle, kernel_ops):
+    """2 core layers x 2 passes (plus a prelude and a coda layer), random
+    weights: a prefill of the loop model matches a plain torch forward of
+    the same weights and inputs; with the model's AttnRes and controller
+    kernels in it, bit for bit."""
+    llm = LLM(
+        model=_write_model(tmp_path, TINY_LOOP_CONFIG),
+        load_format="dummy",
+        skip_tokenizer_init=True,
+        tokenizer_mode="hf",
+        gpu_memory_utilization=0.035,
+        max_model_len=2048,
+        max_num_seqs=1,
+        # One 200-token prefill.
+        max_num_batched_tokens=256,
+        enforce_eager=True,
+        enable_prefix_caching=False,
+        limit_mm_per_prompt={"image": 0},
+        hf_overrides={"text_config": {"loop_num_passes": 2}},
+    )
+    assert llm.llm_engine.model_config.hf_text_config.num_layer_visits == 6
+    llm.apply_model(partial(_compare_loop_reference, kernel_ops=kernel_ops))
+    prompt = list(range(2, 202))
+    llm.generate(
+        [{"prompt_token_ids": prompt}],
+        SamplingParams(max_tokens=1, ignore_eos=True, detokenize=False),
+    )
+    results = llm.apply_model(_reference_results)[0]
+    # One prefill forward of the prompt.
+    assert [r[0] for r in results] == [len(prompt)], results
+    _, magnitude, error, *_ = results[0]
+    assert magnitude > 0
+    # Per token, the relative RMS error of the final-norm output: 0 on the

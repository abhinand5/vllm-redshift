+    expert_re = re.compile(r"^model\.llm\.layers\.(\d+)\.mlp\.experts\.(.+)$")
+    seen_experts: dict[int, set[str]] = {}
+    unlisted = []
+    for name, (shape, dtype) in _header(MODEL_FILE).items():
+        if name.startswith("model.visual."):
+            # Vision tensors are BF16 casts like the rest of the model.
+            assert dtype == torch.bfloat16, name

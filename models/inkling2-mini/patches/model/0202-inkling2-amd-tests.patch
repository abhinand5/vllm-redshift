+    from vllm.models.inkling2.amd.ops.linear import gemv
+    from vllm.models.inkling2.amd.ops.segment_gemv import segment_gemv
+
+    torch.manual_seed(0)
+    k = 2304
+    big = (torch.randn(sum(sizes) + 9, k, device=DEVICE) * k**-0.5).bfloat16()
+    weights = list(big[3 : 3 + sum(sizes)].split(sizes))
+    xs = torch.randn(3, 1, k, device=DEVICE).bfloat16()
+    pairs = [(xs[i % 3], w) for i, w in enumerate(weights)]
+
+    def check(outs):
+        assert len(outs) == len(pairs)
+        for out, (x, w) in zip(outs, pairs):
+            torch.testing.assert_close(out, gemv(x, w), atol=0, rtol=0)
+
+    check(segment_gemv(pairs))
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        outs = segment_gemv(pairs)
+    for _ in range(2):
+        xs.copy_(torch.randn_like(xs))
+        graph.replay()
+        check(outs)
+

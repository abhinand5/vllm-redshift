+            continue
+        m = expert_re.match(name)
+        if m is not None:
+            layer, param = int(m.group(1)), m.group(2)
+            fmt = config.expert_format(layer)
+            assert param in expected[fmt], f"{name}: not an {fmt} expert tensor"
+            assert expected[fmt][param] == (shape, dtype), name
+            seen_experts.setdefault(layer, set()).add(param)
+            if param.endswith("_weight"):

+    enforce_eager: bool = False,
+    prefix_caching: bool = False,
+    prompts: list[list[int]],
+    max_tokens: int = 16,
+    prompt_logprobs: bool = True,
+):
+    from vllm.models.inkling2.amd.sconv import Inkling2ConvState
+
+    # In-process engine so the manager switch reaches the worker.
+    monkeypatch.setenv("VLLM_ENABLE_V1_MULTIPROCESSING", "0")
+    monkeypatch.setattr(Inkling2ConvState, "tail_only", tail_only)
+    llm = LLM(
+        speculative_config=(
+            {"method": "dspark", "num_speculative_tokens": 7} if speculate else None
+        ),
+        model=model,
+        load_format="dummy",
+        skip_tokenizer_init=True,
+        tokenizer_mode="hf",
+        gpu_memory_utilization=0.10,
+        # 64-token chunks: a chunk's interior conv blocks are left null.
+        max_num_batched_tokens=64,
+        max_model_len=2048,
+        max_num_seqs=4,
+        enforce_eager=enforce_eager,
+        enable_prefix_caching=prefix_caching,
+        limit_mm_per_prompt={"image": 0},
+    )
+    managers = llm.collective_rpc(_conv_managers)[0]
+    assert managers == {
+        "TailSlidingWindowManager" if tail_only else "SlidingWindowManager"
+    }
+    if poison:
+        llm.collective_rpc(_poison_null_block)
+    results = []
+    for prompt in prompts:
+        # One request at a time: the same batches with either manager.
+        out = llm.generate(
+            [{"prompt_token_ids": prompt}],
+            SamplingParams(
+                max_tokens=max_tokens,
+                temperature=0,
+                logprobs=0,
+                # Prompt logprobs skip prefix-cache reads.
+                prompt_logprobs=0 if prompt_logprobs else None,
+                ignore_eos=True,
+                detokenize=False,
+            ),
+        )[0]
+        completion = out.outputs[0]
+        assert completion.logprobs is not None
+        results.append(
+            (
+                out.num_cached_tokens,
+                [
+                    next(iter(d.values())).logprob
+                    for d in out.prompt_logprobs or [None]
+                    if d
+                ],
+                list(completion.token_ids),
+                [
+                    lp[t].logprob
+                    for lp, t in zip(completion.logprobs, completion.token_ids)
+                ],
+            )
+        )
+    del llm
+    cleanup_dist_env_and_memory()
+    return results

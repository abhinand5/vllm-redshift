+def _poison_null_block(worker) -> None:
+    """Fill block 0 (the null block) of every paged cache with NaN before
+    each forward: a read of a null block-table entry then shows up as NaN."""
+    runner = worker.model_runner
+    context = runner.vllm_config.compilation_config.static_forward_context
+    caches = [
+        layer.kv_cache
+        for layer in context.values()
+        if isinstance(getattr(layer, "kv_cache", None), torch.Tensor)
+        and layer.kv_cache.numel() > 0
+    ]
+    assert caches
+
+    def poison(*_):
+        for cache in caches:
+            # uint8 is FP8 storage: 0xFF is E4M3 NaN.
+            cache[0].fill_(255 if cache.dtype == torch.uint8 else float("nan"))
+
+    runner.model.register_forward_pre_hook(poison)

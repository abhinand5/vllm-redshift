+        _check_bmm(*case, f"L{layer} {name} gemv", kernel="gemv")
+        # Decode routing: a row or two per expert.
+        case = _bmm_case([1, 2, 1, 1], n, k, tile, weight, weight_scale, amax, 1)
+        _check_bmm(*case, f"L{layer} {name} gemv decode", kernel="gemv")
+
+
+@pytest.mark.parametrize("kernel", ["wmma", "gemv"])
+def test_nvfp4_bmm_graph_capture(kernel: str):
+    """The GEMM captures in a (HIP) graph and replays on new routing and
+    activations with the same result as eager calls."""
+    torch.manual_seed(0)
+    n, k, tile = 256, 512, 16
+    weight, weight_scale = _random_nvfp4(4, n, k)
+    amax = torch.rand(4, device="cuda") + 1
+    plan, args, *_ = _bmm_case([2, 5, 0, 1], n, k, tile, weight, weight_scale, amax)
+    static = [a.clone() for a in args]
+    _run_kernel(kernel, static, plan)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = _run_kernel(kernel, static, plan)
+    for counts, seed in (([2, 5, 0, 1], 1), ([0, 1, 7, 0], 2)):
+        _, new, index, *_ = _bmm_case(
+            counts, n, k, tile, weight, weight_scale, amax, seed
+        )
+        for dst, src in zip(static, new):
+            dst.copy_(src)
+        graph.replay()
+        torch.cuda.synchronize()
+        assert torch.equal(out[index], _run_kernel(kernel, new, plan)[index])
+
+
+# --- NVFP4 MoE layer --------------------------------------------------------
+
+
+def _random_moe_weights(fmt: str) -> dict[str, torch.Tensor]:
+    torch.manual_seed(0)
+    weights = {
+        "gate.weight": (torch.randn(16, 512, device="cuda") * 0.05).bfloat16(),
+        "gate.bias": torch.randn(16, device="cuda") * 0.01,
+    }
+    for name, n, k in (("w13", 512, 512), ("w2", 512, 256)):
+        prefix = f"experts.{name}_weight"
+        if fmt == "nvfp4":
+            weights[prefix], weights[f"{prefix}_scale"] = _random_nvfp4(16, n, k)
+            weights[f"{prefix}_amax"] = torch.rand(16, device="cuda") * 100 + 100
+            weights[f"{prefix}_outer_scale_denominator"] = torch.tensor(
+                [2688.0], device="cuda"
+            )
+        else:
+            weights[prefix], weights[f"{prefix}_scale"] = _random_mxfp8(16, n, k)
+    return weights
+
+
+def _moe_reference(moe, x: torch.Tensor, cfg) -> torch.Tensor:
+    """Per-token loop over the selected experts' fp64-dequantized weights,
+    MXFP8 activations (as the ROCm layer quantizes them)."""
+    from vllm.models.inkling2.amd.ops.linear import linear_k_groups
+
+    logits = linear_k_groups(x, moe.gate.weight).float()
+    keys = torch.sigmoid(logits) + moe.gate.bias
+    ids = keys.topk(cfg.num_experts_per_tok, -1, sorted=False).indices
+    selected = torch.sigmoid(logits.gather(1, ids))
+    weights = selected / selected.sum(-1, keepdim=True) * cfg.route_scale
+    exp = moe.experts
+
+    def linear(a, name, e):
+        av, as_ = mxfp8_quantize(a)
+        w = getattr(exp, f"{name}_weight")[e]
+        s = getattr(exp, f"{name}_weight_scale")[e]
+        if exp.nvfp4:
+            amax = getattr(exp, f"{name}_weight_amax")[e : e + 1]
+            den = getattr(exp, f"{name}_weight_outer_scale_denominator")
+            wd = _oracle_nvfp4(w[None], s[None], amax, den)[0]
+        else:
+            wd = _dequant_mxfp8(w, s)
+        return (_dequant_mxfp8(av, as_) @ wd.T).bfloat16()
+
+    out = torch.zeros(x.shape, dtype=torch.float64, device=x.device)
+    for t in range(x.shape[0]):
+        for slot in range(ids.shape[1]):
+            e = ids[t, slot].item()
+            gate_up = linear(x[t : t + 1], "w13", e).double()
+            gate, up = gate_up[:, 0::2], gate_up[:, 1::2]
+            act = (
+                cfg.mlp_gate_softcap
+                * torch.tanh(gate / cfg.mlp_gate_softcap)
+                * torch.sigmoid(gate)
+                * cfg.mlp_up_softcap
+                * torch.tanh(up / cfg.mlp_up_softcap)
+                * weights[t, slot].double()
+            )
+            out[t] += linear(act.bfloat16(), "w2", e)[0].double()
+    return out.bfloat16()
+
+
+def _build_moe(fmt: str, weights: dict[str, torch.Tensor]):
+    with torch.device("cuda"):
+        moe = moe_module.Inkling2MoE(MOE_CONFIG, fmt)
+    params = dict(moe.named_parameters())
+    assert params.keys() == weights.keys()
+    for name, param in params.items():
+        param.weight_loader(param, weights[name])
+    return moe
+
+
+@pytest.mark.parametrize("fmt", ["nvfp4", "mxfp8"])
+def test_expert_parameters_per_format(dist_init, fmt: str):
+    """Checkpoint shapes and dtypes of Mini's expert tensors per format."""
+    params = _expert_params(fmt)
+    if fmt == "nvfp4":
+        assert params == {
+            "w13_weight": ((128, 2304, 1152), torch.uint8),
+            "w13_weight_scale": ((128, 2304, 144), torch.float8_e4m3fn),
+            "w13_weight_amax": ((128,), torch.float32),
+            "w13_weight_outer_scale_denominator": ((1,), torch.float32),
+            "w2_weight": ((128, 2304, 576), torch.uint8),
+            "w2_weight_scale": ((128, 2304, 72), torch.float8_e4m3fn),
+            "w2_weight_amax": ((128,), torch.float32),
+            "w2_weight_outer_scale_denominator": ((1,), torch.float32),
+        }
+    else:
+        assert params == {
+            "w13_weight": ((128, 2304, 2304), torch.float8_e4m3fn),
+            "w13_weight_scale": ((128, 2304, 72), torch.uint8),
+            "w2_weight": ((128, 2304, 1152), torch.float8_e4m3fn),
+            "w2_weight_scale": ((128, 2304, 36), torch.uint8),
+        }
+    with pytest.raises(ValueError, match="Unsupported Inkling2 expert format"):
+        moe_module.Inkling2Experts(MINI_MOE_CONFIG, "bf16")
+
+
+@pytest.mark.parametrize("tokens", [5, 33, 200])
+def test_nvfp4_moe_layer_matches_reference(dist_init, tokens: int):
+    """Full NVFP4 layer (TP=1, gfx12 GEMM) vs. a per-token loop over
+    fp64-dequantized experts, fused (few tokens) and separate routing."""
+    moe = _build_moe("nvfp4", _random_moe_weights("nvfp4"))
+    x = torch.randn(tokens, 512, device="cuda").bfloat16()
+    out = moe(x)
+    ref = _moe_reference(moe, x, MOE_CONFIG)
+    scale = ref.abs().max().item()
+    assert scale > 0.1
+    torch.testing.assert_close(out, ref, atol=1e-2 * scale, rtol=2e-2)
+
+
+def test_route_layout_matches_nvfp4_gemm_rows(dist_init):
+    """The NVFP4 GEMM reads exactly the rows `route` fills: zeroing the
+    unrouted rows of its input changes nothing."""
+    moe = _build_moe("nvfp4", _random_moe_weights("nvfp4"))
+    x = torch.randn(9, 512, device="cuda").bfloat16()
+    exp = moe.experts
+    plan = exp.plan(x.shape[0])
+    routing, (act, act_scale) = route(
+        x,
+        moe.gate.weight,
+        moe.gate.bias,
+        moe.gate.counters,
+        exp.counts,
+        moe.gate.topk,
+        moe.gate.route_scale,
+        exp.expert_bounds,
+        plan,
+        None,
+    )
+    tiles = routing[3]
+    out = exp._gemm((act, act_scale), "w13", tiles, plan)
+    host = tiles.tolist()
+    used = torch.zeros(plan.rows, dtype=torch.bool, device="cuda")
+    for t in range(host[2 * plan.max_ctas]):
+        used[t * plan.tile : host[plan.max_ctas + t]] = True
+    masked = act.clone()
+    masked.view(torch.uint8)[~used] = 0
+    again = exp._gemm((masked, act_scale), "w13", tiles, plan)
+    assert torch.equal(out[used], again[used])
+    assert used.sum().item() == x.shape[0] * moe.gate.topk

+def test_draft_kv_write_matches_cache_layout():
+    """The ROCm draft scatters K/V into the `[blocks, block_size, kv_heads,
+    (K | V)]` cache `block_decode_attention` reads; padded tokens beyond the
+    slot mapping and `-1` slots write nothing."""
+    from vllm.models.inkling2.amd.dspark import Inkling2DraftSelfAttention
+
+    g = torch.Generator().manual_seed(855)
+    num_blocks, page, num_kv_heads, head_dim = 6, 16, 2, 128
+    num_slots, num_padded = 21, 24
+    kv = torch.zeros(
+        num_blocks, page, num_kv_heads, 2 * head_dim, dtype=torch.bfloat16
+    ).to(DEVICE)
+    # As the backend hands it to the layer: (blocks, heads, block_size, 2 D).
+    attn = SimpleNamespace(
+        kv_cache=kv.transpose(1, 2),
+        kv_cache_dtype="auto",
+        _k_scale=torch.ones((), device=DEVICE),
+        _v_scale=torch.ones((), device=DEVICE),
+    )
+    # k contiguous, v a column slice of a fused projection (as in the model).
+    k = torch.randn(num_padded, num_kv_heads, head_dim, generator=g).bfloat16()
+    kv_proj = torch.randn(num_padded, 3 * num_kv_heads * head_dim, generator=g)
+    k, kv_proj = k.to(DEVICE), kv_proj.bfloat16().to(DEVICE)
+    v = kv_proj[:, : num_kv_heads * head_dim].view(-1, num_kv_heads, head_dim)
+    slots = torch.randperm(num_blocks * page, generator=g)[:num_slots]
+    slots[3] = -1
+    slots = slots.to(DEVICE)
+    layer = SimpleNamespace(attn=attn, head_dim=head_dim)
+    layer._cache = partial(Inkling2DraftSelfAttention._cache, layer)
+    Inkling2DraftSelfAttention._write_kv(layer, k, v, slots)
+
+    ref = torch.zeros_like(kv).flatten(0, 1)
+    keep = slots >= 0
+    ref[slots[keep], :, :head_dim] = k[:num_slots][keep]
+    ref[slots[keep], :, head_dim:] = v[:num_slots][keep]
+    assert torch.equal(kv.flatten(0, 1), ref)

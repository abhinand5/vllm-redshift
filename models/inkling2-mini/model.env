# Inkling-2-Mini on 1x Radeon AI PRO R9700 (gfx1201)
VLLM_COMMIT=bf151b7eb1403d3671200e0cd19ad9821fe4320f   # upstream vllm-project/vllm main, 2026-11-21
PATCHES="upstream/0001-pr67685-inkling2-small-rocm.patch upstream/0002-pr69028-inkling2-mini.patch core/0101-rocm-rdna4-gpu-max-hw-queues.patch core/0102-config-gfx12-bringup.patch core/0103-v1-tail-sliding-window-manager.patch core/0104-gpu-runner-adaptive-verify-profile.patch model/0201-inkling2-amd-gfx1201.patch model/0202-inkling2-amd-tests.patch"   # applied in order from patches/ (see series.conf)
VERSION=0.4.1                                            # semver of this port, see CHANGELOG.md; release tag inkling2-mini/v$VERSION
IMAGE=${IMAGE:-vllm-redshift:inkling2-mini}
HF_MODEL=thinkingmachines/Inkling-2-Mini                 # checkpoint revision ed40e7d, served as shipped (NVFP4 + MXFP8)
MODEL_DIR=${MODEL_DIR:-$HOME/models/Inkling-2-Mini}
SERVED_NAME=Inkling-2-Mini
PORT=${PORT:-8005}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-196608}                   # full context; FP8 KV, shared by up to 2 requests
SPEC_ARGS=${SPEC_ARGS-'--speculative-config {"method":"dspark","num_speculative_tokens":7,"kv_cache_dtype":"fp8","enable_adaptive_verification":true,"draft_sample_method":"probabilistic"}'}   # DSpark draft (mtp.safetensors), FP8 draft KV, adaptive verify width, sampled drafts (faster at T>0); SPEC_ARGS= to disable
SERVE_ARGS="--max-num-seqs 2 --kv-cache-dtype fp8 --kv-cache-memory-bytes ${KV_CACHE_BYTES:-9126805504} --reasoning-parser inkling --tool-call-parser inkling --enable-auto-tool-choice --limit-mm-per-prompt {\"image\":64}"

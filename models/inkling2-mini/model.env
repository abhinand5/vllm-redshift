# Inkling-2-Mini on 1x Radeon AI PRO R9700 (gfx1201)
VLLM_COMMIT=bf151b7eb1403d3671200e0cd19ad9821fe4320f   # upstream vllm-project/vllm main, 2026-11-21
PATCHES="0001-inkling2-mini-r9700.patch"                 # applied in order from patches/
IMAGE=vllm-redshift:inkling2-mini
HF_MODEL=thinkingmachines/Inkling-2-Mini                 # checkpoint revision ed40e7d, served as shipped (NVFP4 + MXFP8)
MODEL_DIR=${MODEL_DIR:-$HOME/models/Inkling-2-Mini}
SERVED_NAME=Inkling-2-Mini
PORT=${PORT:-8005}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-32768}                    # target 196608; validated so far at <= 32K
SERVE_ARGS="--max-num-seqs 1 --gpu-memory-utilization 0.90 --reasoning-parser inkling --tool-call-parser inkling --enable-auto-tool-choice --limit-mm-per-prompt {\"image\":0}"
